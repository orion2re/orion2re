#version 450
// Convert the published indexed frame and optional color-keyed cursor on the GPU.
layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(set=0, binding=0) uniform sampler2D indices;
layout(set=0, binding=1) uniform sampler2D palette;
layout(set=0, binding=2) uniform sampler2D cursor;
layout(set=1, binding=0, rgba8) uniform writeonly image2D output_texture;
layout(set=2, binding=0, std140) uniform Parameters {
    ivec2 size;
    ivec2 cursor_position;
    int cursor_enabled;
} params;
void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(position, params.size))) return;
    int index = int(round(texelFetch(indices, position, 0).r * 255.0));
    ivec2 cursor_position = position - params.cursor_position;
    if (params.cursor_enabled != 0 && all(greaterThanEqual(cursor_position, ivec2(0))) &&
        all(lessThan(cursor_position, ivec2(24)))) {
        int cursor_index = int(round(texelFetch(cursor, cursor_position, 0).r * 255.0));
        if (cursor_index != 0) index = cursor_index;
    }
    imageStore(output_texture, position, texelFetch(palette, ivec2(index, 0), 0));
}
