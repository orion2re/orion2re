      description: "AI-only forced economic production policy.",
      fields: [
        { id: "enabled", title: "Enabled", description: "Enables forced production during the native economic emergency gate.", type: "bool", bind: ["enabled"] },
        { id: "product", title: "Product", description: "Internal AI product selected by the policy.", type: "strategic_economic_product", bind: ["product"] },
      ],
    },
    strategic_expansion: {
      title: "Strategic expansion",
      description: "Industry thresholds for the ordered Colony Base and Colony Ship policy.",
      fields: [
        { id: "enabled", title: "Enabled", description: "Enables strategic expansion assignment.", type: "bool", bind: ["enabled"] },
        { id: "colony_base_minimum_industry", title: "Colony Base industry", description: "Minimum colony industry for Colony Base assignment.", type: "int16", bind: ["colony_base_minimum_industry"] },
        { id: "colony_ship_minimum_industry", title: "Colony Ship industry", description: "Minimum colony industry for Colony Ship assignment.", type: "int16", bind: ["colony_ship_minimum_industry"] },
      ],
    },
    strategic_allocation: {
      title: "Strategic production allocation",
