      description: "Requires a colony's base food per farmer to exceed this value before newly grown population may be assigned to farming.",
      remarks: "Zero preserves classic behavior. Values use the native half-food-per-farmer scale and the comparison is strict.",
      examples: ["colony new_farmer_food_threshold = 2;"],
      units: "half-food per farmer",
      group: "gameplay",
      namespace: "colony",
      type: "uint8",
      constraints: { max: 127 },
      default: 0,
      bind_root: {
