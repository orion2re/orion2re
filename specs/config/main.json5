      title: "Monster combat statistics",
      description: "Configures structural hit points and fallback combat-speed drives for system guardians and random-event monsters.",
      remarks: "Each ship design owns its FTL drive. A design with No Drive remains stationary and uses its monster drive only to derive combat speed.",
      examples: [
        "ships monster hit_points system_eel = 300;",
        "ships monster hit_points system_crystal = 500;",
        "ships monster hit_points system_hydra = 600;",
        "ships monster hit_points system_dragon = 700;",
        "ships monster hit_points event_crystal = 2500;",
        "ships monster hit_points event_dragon = 3000;",
        "ships monster drives amoeba = fusion;",
        "ships monster drives guardian = anti_matter;",
        "ships monster drives crystal = anti_matter;",
        "ships monster drives dragon = interphased;",
        "ships monster drives eel = interphased;",
        "ships monster drives hydra = fusion;",
      ],
      group: "gameplay",
      namespace: "ships",
      type: {
        kind: "record",
        fields: [
          { id: "hit_points", title: "Hit points", description: "Structural hit points by monster and encounter type.", type: "monster_hit_points", bind: ["hit_points"] },
          { id: "drives", title: "Drives", description: "Fallback drives by monster family.", type: "monster_drives", bind: ["drives"] },
        ],
      },
      bind_root: { header: "game/ship_config.h", symbol: "SHIP_CONFIG::monster" },
      default_source: "native",
    },
    avenger: {
      title: "Avenger design",
      description: "Configures the Loknar or Avenger ship.",
      group: "gameplay",
      namespace: "ships",
      type: "predefined_ship_design",
      bind_root: { header: "game/ship_config.h", symbol: "SHIP_CONFIG::avenger_template" },
