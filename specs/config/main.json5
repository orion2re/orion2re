    bonus: {
      title: "Combat special-system bonuses",
      description: "Controls combat bonuses and defenses provided by selected special systems and orbital defenses.",
      examples: ["combat bonus battle_scanner_beam_offense = 50;", "combat bonus stealth_field_beam_defense = 0;"],
      group: "gameplay",
      namespace: "combat",
      type: {
        kind: "record",
        fields: [
          { id: "battle_scanner_beam_offense", title: "Battle Scanner beam offense", description: "Beam attack bonus provided by a working Battle Scanner.", units: "beam attack", type: "uint8", bind: ["battle_scanner_beam_offense"] },
          { id: "scout_lab_fleet_beam_offense", title: "Scout Lab fleet beam offense", description: "Fleet beam attack bonus provided by a working Scout Lab against Ancient ships.", units: "beam attack", type: "uint8", bind: ["scout_lab_fleet_beam_offense"] },
          { id: "starbase_fleet_beam_offense", title: "Star Base fleet beam offense", description: "Fleet beam attack bonus provided by an active Star Base.", units: "beam attack", type: "uint8", bind: ["starbase_fleet_beam_offense"] },
          { id: "battlestation_fleet_beam_offense", title: "Battlestation fleet beam offense", description: "Fleet beam attack bonus provided by an active Battlestation.", units: "beam attack", type: "uint8", bind: ["battlestation_fleet_beam_offense"] },
          { id: "starfortress_fleet_beam_offense", title: "Star Fortress fleet beam offense", description: "Fleet beam attack bonus provided by an active Star Fortress.", units: "beam attack", type: "uint8", bind: ["starfortress_fleet_beam_offense"] },
          { id: "inertial_stabilizer_beam_defense", title: "Inertial Stabilizer beam defense", description: "Beam defense provided by an Inertial Stabilizer.", units: "beam defense", type: "uint8", bind: ["inertial_stabilizer_beam_defense"] },
          { id: "inertial_nullifier_beam_defense", title: "Inertial Nullifier beam defense", description: "Beam defense provided by an Inertial Nullifier.", units: "beam defense", type: "uint8", bind: ["inertial_nullifier_beam_defense"] },
          { id: "stealth_field_beam_defense", title: "Stealth Field beam defense", description: "Beam defense provided by Stealth Field while cloaked. Zero preserves classic non-cloaking behavior.", units: "beam defense", type: "uint8", bind: ["stealth_field_beam_defense"] },
          { id: "cloaking_device_beam_defense", title: "Cloaking Device beam defense", description: "Beam defense provided by a working Cloaking Device.", units: "beam defense", type: "uint8", bind: ["cloaking_device_beam_defense"] },
          { id: "phasing_cloak_beam_defense", title: "Phasing Cloak beam defense", description: "Beam defense provided by a working Phasing Cloak after it becomes an ordinary cloak.", units: "beam defense", type: "uint8", bind: ["phasing_cloak_beam_defense"] },
          { id: "phasing_cloak_effective_turns", title: "Initial Phasing Cloak duration", description: "Combat rounds a working Phasing Cloak starts phase-cloaked.", units: "turns", type: "uint8", bind: ["phasing_cloak_effective_turns"] },
          { id: "displacement_device_beam_miss_percent", title: "Displacement Device beam miss chance", description: "Chance for an incoming beam or Energy Absorber attack to miss a ship with a working Displacement Device.", units: "percent", type: "uint8", constraints: { max: 100 }, bind: ["displacement_device_beam_miss_percent"] },
          { id: "reflection_field_strength", title: "Reflection Field strength", description: "Random-range bonus that determines whether Reflection Field returns a beam hit.", type: "uint8", bind: ["reflection_field_strength"] },
        ],
      },
      bind_root: { header: "game/cmbtfir2.h", symbol: "CMBTFIR2::combat_bonus" },
      default: {
        battle_scanner_beam_offense: 50, scout_lab_fleet_beam_offense: 20,
        starbase_fleet_beam_offense: 0, battlestation_fleet_beam_offense: 10,
        starfortress_fleet_beam_offense: 20, inertial_stabilizer_beam_defense: 50,
        inertial_nullifier_beam_defense: 100, stealth_field_beam_defense: 0,
        cloaking_device_beam_defense: 80, phasing_cloak_beam_defense: 80,
        phasing_cloak_effective_turns: 10, displacement_device_beam_miss_percent: 30,
        reflection_field_strength: 15,
      },
    },

    crew: {
