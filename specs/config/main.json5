      fields: [
        { id: "cutoff", title: "Cutoff", description: "Selector-wide cutoff policy.", type: "production_cutoff", bind: ["cutoff"] },
        { id: "candidates", title: "Candidates", description: "Rules keyed by strategic production action.", bind: ["candidates"], type: { kind: "map", count: 6, index_base: 0, index_type: "strategic_production_choice", element: { type: "production_candidate" } } },
      ],
    },
    ai_strategic_production: {
      title: "AI strategic production",
      description: "Empire-level forced and weighted production policy used only by computer players.",
