        mineral_class: 12, incoming_human_ships: 13, enemy_presence: 14,
        neutral_presence: 15, allied_presence: 16, out_of_range_presence: 17,
        empire_food_surplus: 18, empire_treasury: 19, empire_bc_surplus: 20,
        command_point_deficit: 21, war_level: 22, current_strength: 23,
        desired_strength: 24, combat_need: 25, freighter_need: 26, spy_need: 27,
        transport_need: 28, refit_need: 29, existing_colony_ships: 30,
        treasury_score: 31, local_threat: 32, extension_1: 33, extension_2: 34,
        extension_3: 35, extension_4: 36, extension_5: 37, extension_6: 38,
        extension_7: 39,
      },
    },
    production_flag: {
      title: "AI production fact",
      description: "Selects one normalized boolean fact available to AI production rules.",
      remarks: "Facts are calculated before candidate eligibility and weight evaluation.",
      kind: "enum", base_type: "uint8",
      values: {
        conquered: 0, building_focus: 1, research_enabled: 2, threatened: 3,
        at_war: 4, is_homeworld: 5, empire_food_deficit: 6, empire_low_money: 7,
        objective_ecologist: 8, objective_industrialist: 9, objective_militarist: 10,
        objective_technologist: 11, food_buildings_applicable: 12,
        pollution_controls_applicable: 13, orbital_defense_applicable: 14,
        planetary_defense_applicable: 15, combat_ship_available: 16,
        transport_design_available: 17, refit_available: 18,
        colonizable_planet_available: 19, same_system_target_available: 20,
        population_or_wealth_gate: 21, missing_armor_barracks_for_government: 22,
        missing_marine_barracks_for_government: 23,
      },
    },
    production_requirement: {
      title: "AI production requirement",
      description: "Requires, forbids, or ignores a boolean production fact.",
      remarks: "Ignored removes an inherited requirement without changing the fact itself.",
      kind: "enum", base_type: "uint8",
      values: { ignored: 0, required: 1, forbidden: 2 },
    },
    production_comparison: {
      title: "AI production comparison",
      description: "Selects an integer comparison or disables an inherited comparison.",
      remarks: "Ignore disables the comparison and leaves its stored value unused.",
      kind: "enum", base_type: "uint8",
      values: { ignore: 0, eq: 1, ne: 2, lt: 3, le: 4, gt: 5, ge: 6 },
    },
    production_transform: {
      title: "AI production metric transform",
      description: "Selects direct integer scaling or an integer square root.",
      remarks: "Square root uses deterministic integer rounding down.",
      kind: "enum", base_type: "uint8",
      values: { linear: 0, sqrt: 1 },
    },
    production_cutoff_mode: {
      title: "AI production cutoff mode",
      description: "Disables cutoff or filters candidates relative to the reference maximum.",
      remarks: "Disabled leaves the existing selector weights unchanged.",
      kind: "enum", base_type: "uint8",
      values: { disabled: 0, relative: 1 },
    },
    production_cutoff_stage: {
      title: "AI production cutoff stage",
      description: "Controls how one candidate participates in relative cutoff processing.",
      remarks: "After candidates do not contribute to the reference maximum.",
      kind: "enum", base_type: "uint8",
      values: { normal: 0, protected: 1, after: 2 },
    },
    autobuild_cutoff_context: {
      title: "Autobuild cutoff context",
      description: "Selects a game difficulty or human legacy autobuild for relative cutoff.",
      remarks: "Human selects the fixed legacy-autobuild cutoff independently of game difficulty.",
      kind: "enum", base_type: "uint8",
      values: { tutor: 0, easy: 1, average: 2, hard: 3, impossible: 4, human: 5 },
    },
    production_weight_formula: {
      title: "AI production weight formula",
      description: "Selects the generic or named calculation used as a candidate's initial weight.",
      remarks: "Legacy retains the existing native calculation before configured terms are applied.",
      kind: "enum", base_type: "uint8",
      values: { additive: 0, legacy: 1, combat_need_ratio: 2, strategic_need: 3, defer: 4 },
    },
    production_wartime_factor: {
      title: "AI production wartime factor",
      description: "Selects the wartime adjustment used by a strategic-need formula.",
      remarks: "The selected adjustment uses deterministic integer arithmetic.",
      kind: "enum", base_type: "uint8",
      values: { none: 0, ratio: 1, inverse_war_level_squared: 2 },
    },
    autobuild_candidate: {
      title: "Autobuild candidate",
      description: "Identifies a native building or a synthetic colony production project.",
      remarks: "Housing and Trade Goods follow the native building ID range.",
      kind: "enum", base_type: "uint8",
      values: {
        none: 0, alien_control_center: 1, armor_barracks: 2, artemis_system_net: 3,
        astro_university: 4, atmosphere_renewer: 5, autolab: 6, automated_factory: 7,
        battlestation: 8, capitol: 9, cloning_center: 10, colony_base: 11,
        deep_core_mine: 12, core_waste_dump: 13, dimensional_portal: 14, biospheres: 15,
        food_replicators: 16, gaia_transformation: 17, currency_exchange: 18,
        galactic_cybernet: 19, holo_simulator: 20, hydroponic_farm: 21,
        marine_barracks: 22, barrier_shield: 23, flux_shield: 24, gravity_generator: 25,
        missile_base: 26, ground_batteries: 27, radiation_shield: 28, stock_exchange: 29,
        supercomputer: 30, pleasure_dome: 31, pollution_processor: 32, recyclotron: 33,
        robotic_factory: 34, research_lab: 35, robo_miner_plant: 36, soil_enrichment: 37,
        space_academy: 38, spaceport: 39, star_base: 40, star_fortress: 41,
        stellar_converter: 42, subterranean_farms: 43, terraforming: 44,
        warp_interdictor: 45, weather_controller: 46, fighter_garrison: 47,
        artificial_planet: 48, housing: 49, trade_goods: 50,
      },
    },
    strategic_production_choice: {
