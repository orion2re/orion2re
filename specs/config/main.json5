    smarter_fighter_retargeting: {
      title: "Smarter fighter retargeting",
      description: "Retargets active fighter sorties once per combat round, preferring ordinary ships and enemy fighter groups. Satellites are considered only when all such candidates are excluded, and the planet last. Within each category, immediate contact and shorter estimated pursuit come first; targets in the same estimated-round band favor lower speed, then smaller hulls.",
      remarks: "Fighters never automatically retarget to missiles. Returning fighters stay on course; only fighters able to attack other fighter groups consider those groups. False preserves classic behavior.",
      examples: ["combat smarter_fighter_retargeting = true;"],
      group: "gameplay",
      namespace: "combat",
      type: "bool",
      default: false,
      bind_root: { header: "game/cmbtmis.h", symbol: "CMBTMIS::smarter_fighter_retargeting" },
    },

    fighter_max_pursuit_turns: {
      title: "Maximum estimated fighter pursuit turns",
      description: "Limits estimated additional combat rounds needed to reach a target when smarter fighter retargeting is enabled.",
      remarks: "Immediate contact uses the sortie's remaining travel budget and the target's impact radius. Further pursuit initially uses distance and fighter speed, without assuming the target retreats. Once-per-round observations of outward target movement and actual closure adjust that estimate: a failed pursuit adds one round, and two failed observations make the chase unworthwhile. Each sortie remembers up to four failed targets for three rounds after the last failure, across target switches; abandoned failed chases remain unworthwhile during that cooldown. Observed closure or non-escaping movement clears that target's penalty; immediate contact always overrides it. Zero permits immediate contact only. This is a recalculated estimate, not an elapsed sortie timer.",
      examples: ["combat fighter_max_pursuit_turns = 3;"],
      units: "additional combat rounds",
      group: "gameplay",
      namespace: "combat",
      type: "uint16",
      default: 3,
      bind_root: { header: "game/cmbtmis.h", symbol: "CMBTMIS::fighter_max_pursuit_turns" },
    },

    fighter_pursuit_fallback: {
      title: "Fighter pursuit fallback",
      description: "Selects whether fighters return to their carrier or pursue poor targets when no worthwhile target exists.",
      remarks: "Applies only with smarter fighter retargeting. Pursue keeps poor movable targets eligible as a last resort before considering stationary defenses; when all alternatives in a category are poor, fighters retain their current legal assignment instead of alternating chases. Return excludes poor targets, permitting defense fallback when no movable candidate remains. Pursue is the default. With no legal targets, existing return or destruction behavior still applies.",
      examples: ["combat fighter_pursuit_fallback = return;", "combat fighter_pursuit_fallback = pursue;"],
      group: "gameplay",
      namespace: "combat",
      type: "fighter_pursuit_fallback",
      default: "pursue",
      bind_root: { header: "game/cmbtmis.h", symbol: "CMBTMIS::fighter_pursuit_fallback" },
    },

    flyer_combat_modifier: {
      title: "Flyer combat modifiers",
      description: "Configures missile defense adjustments and the base fighter offensive combat value.",
      remarks: "Missile adjustments apply after speed-derived defense. Fighter offense is added after fleet, computer, racial, and pilot bonuses.",
      examples: [
        "combat flyer_combat_modifier nuclear_missile_defense_bonus = -10;",
        "combat flyer_combat_modifier fighters_offense_bonus = 50;",
      ],
      group: "gameplay",
      namespace: "combat",
      type: "flyer_combat_modifier",
      bind_root: { header: "game/cmbtmis.h", symbol: "CMBTMIS::flyer_combat_modifier" },
      default: {
        nuclear_missile_defense_bonus: -10,
        merculite_missile_defense_bonus: 15,
        pulson_missile_defense_bonus: 40,
        zeon_missile_defense_bonus: 70,
        fighters_offense_bonus: 50,
      },
    },

