    population_capacity: {
      title: "Population capacity",
      description: "Configures Gaia-equivalent population capacity by planet size and the percentage available at each climate.",
      remarks: "Population capacity is rounded to the nearest whole population after climate and environmental-immunity adjustments. Size values also govern Artificial Planet initialization and absolute infantry and tank limits.",
      examples: [
        "colony population_capacity size huge = 25;",
        "colony population_capacity climate toxic = 25;",
      ],
      units: "population or percent",
      group: "gameplay",
