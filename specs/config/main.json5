        { id: "system_crystal", title: "System Crystal", description: "Hit points of a stationary Crystal; -1 uses system_crystal_hydra_dragon.", type: "int16", constraints: { min: -1 }, bind: ["system_crystal"] },
        { id: "system_hydra", title: "System Hydra", description: "Hit points of a stationary Hydra; -1 uses system_crystal_hydra_dragon.", type: "int16", constraints: { min: -1 }, bind: ["system_hydra"] },
        { id: "system_dragon", title: "System Dragon", description: "Hit points of a stationary Dragon; -1 uses system_crystal_hydra_dragon.", type: "int16", constraints: { min: -1 }, bind: ["system_dragon"] },
