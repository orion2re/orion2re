      bind_root: {
        header: "game/techdata.h",
        symbol: "TECHDATA::starting_tech_field_ids",
      },
      type: {
        kind: "array",
        count: 6,
        index_base: 0,
        index_type: "starting_technology_field_slot",
        element: { type: "technology_field_index" },
      },
      default_source: "native",
    },
    lithovore_allows_biomorphic_fungi: {
      title: "Lithovores may research Biomorphic Fungi",
      description: "Makes Biomorphic Fungi available in the technology tree for Lithovore players.",
      remarks: "False preserves classic behavior. Other food technologies remain unavailable to Lithovores.",
      examples: ["technology lithovore_allows_biomorphic_fungi = true;"],
      group: "gameplay",
      namespace: "technology",
      type: "bool",
      default: false,
      bind_root: { header: "game/techinit.h", symbol: "TECHINIT::lithovore_allows_biomorphic_fungi" },
    },

    starting_techfield: {
      title: "Technology branch starting fields",
      description: "Selects the first field displayed and traversed in each technology branch.",
      remarks: "This is independent of technology.starting_fields, which controls fields completed when a game starts. Field zero terminates branch traversal and cannot be selected as a branch root. Defaults preserve the native branch roots and match MOO2 1.50.",
      examples: [
        "technology starting_techfield biology = astro_biology;",
        "technology starting_techfield construction = engineering;",
      ],
      group: "gameplay",
      namespace: "technology",
      type: "starting_techfield",
      bind_root: {
        header: "game/techdata.h",
        symbol: "TECHDATA::starting_techfield",
      },
      default_source: "native",
    },

    simplified_beam_formula: {
      title: "Simplified beam accuracy formula",
      description: "Applies range penalties and Point Defense accuracy as ordinary beam attack modifiers.",
      remarks: "False preserves the classic capped hit-threshold formula. True prevents high beam attack from bypassing range penalties and keeps penalties above 55 effective.",
      examples: ["combat simplified_beam_formula = true;"],
      group: "gameplay",
      namespace: "combat",
      type: "bool",
      bind_root: {
        header: "game/cmbtfire.h",
        symbol: "CMBTFIRE::simplified_beam_formula",
      },
      default: false,
    },

    hit_threshold_fixed_value: {
      title: "Beam hit threshold",
      description: "Sets the fixed threshold used by the classic beam hit formula.",
      remarks: "A beam hit roll must meet this threshold after its attack modifiers. The default 40 preserves classic behavior and MOO2 1.50.",
      examples: ["combat hit_threshold_fixed_value = 40;"],
      group: "gameplay",
      namespace: "combat",
      type: "uint8",
      constraints: { min: 1, max: 100 },
      default: 40,
      bind_root: { header: "game/cmbtfire.h", symbol: "CMBTFIRE::hit_threshold_fixed_value" },
    },

    ion_affects_antarans: {
      title: "Ion weapons affect Antarans",
      description: "Allows ion weapons to target Antaran ships.",
      remarks: "False preserves classic behavior, which excludes ion weapons from Antaran targets.",
      examples: ["combat ion_affects_antarans = true;"],
      group: "gameplay",
      namespace: "combat",
      type: "bool",
      default: false,
      bind_root: { header: "game/cmbtfire.h", symbol: "CMBTFIRE::ion_affects_antarans" },
    },

    marine_kill_damage: {
      title: "Marine-killing weapon damage divisor",
      description: "Divides post-shield damage from weapons with the marine-killing property to determine crew casualties.",
      remarks: "The positive byte directly models the runtime divisor selected by MOO2 1.50. Zero is rejected because this value is used as a divisor. The default of five preserves classic Neutron Blaster and Death Ray marine casualties.",
      examples: ["combat marine_kill_damage = 5;"],
      group: "gameplay",
      namespace: "combat",
      type: "uint8",
      constraints: { min: 1 },
      default: 5,
      bind_root: {
        header: "game/cmbtfire.h",
        symbol: "CMBTFIRE::marine_kill_damage",
      },
    },

    marine_kill_damage_blocker: {
      title: "Marine-killing weapon blocker",
      description: "Selects the ship special system that prevents weapons with the marine-killing property from causing crew casualties.",
      remarks: "Damper Field preserves classic Neutron Blaster and Death Ray behavior. None makes those weapons affect crew aboard every ship.",
      examples: ["combat marine_kill_damage_blocker = damper_field;"],
      group: "gameplay",
      namespace: "combat",
      type: "ship_special",
      default: "damper_field",
      bind_root: {
        header: "game/cmbtfire.h",
        symbol: "CMBTFIRE::marine_kill_damage_blocker",
      },
    },

    ground_defense_armor_multiplier: {
      title: "Ground-defense armor multiplier",
      description: "Multiplies the structure of each planetary ground-defense building after applying the defending armor technology.",
      remarks: "The value is divided by 100. The default 100 preserves classic behavior and matches MOO2 1.50.",
      examples: ["combat ground_defense_armor_multiplier = 150;"],
      units: "percent",
      group: "gameplay",
      namespace: "combat",
      type: "uint16",
      constraints: { min: 1, max: 10000 },
      default: 100,
      bind_root: {
        header: "game/cmbtfire.h",
        symbol: "CMBTFIRE::ground_defense_armor_multiplier",
      },
    },

    print_research_value: {
      title: "Empire Info research value",
      description: "Selects the research value displayed in the Colonies screen Empire Info panel.",
      remarks: "Percentage modes display breakthrough chance when positive. Percentage1 otherwise displays current-turn research; percentage2 otherwise displays research remaining to the field cost.",
      examples: ["interface print_research_value = percentage1;"],
      group: "interface",
      namespace: "interface",
      type: "print_research_value",
      default: "classic",
      bind_root: {
        header: "game/colsum.h",
        symbol: "COLSUM::print_research_value",
      },
    },

    warn_blockers: {
      title: "Warn about build queue blockers",
      description: "Prompts before leaving the colony build screen when Housing, Trade Goods, or Repeat precedes another product.",
      remarks: "When automatic blocker deletion is enabled, blockers are removed without prompting. When this setting is false and automatic deletion is disabled, blockers are retained without a prompt.",
      examples: ["interface warn_blockers = false;"],
      group: "synchronized_interface",
      namespace: "interface",
      type: "bool",
      default: true,
      bind_root: {
        header: "game/colbldg.h",
        symbol: "COLBLDG::warn_blockers",
      },
    },

    build_list_colors: {
      title: "Build-list colors",
      description: "Defines normal and queued font colors for reusable build-list color roles.",
      remarks: "Base, dim, and dark are palette indexes. Native defaults reproduce the classic orange colors and normalize MOO2 1.50's numbered color groups into named roles.",
      examples: [
        "interface build_list_colors default normal base = 0xCB;",
        "interface build_list_colors accent_1 queued dark = 0xB8;",
      ],
      group: "synchronized_interface",
      namespace: "interface",
      bind_root: { header: "game/colbldg.h", symbol: "COLBLDG::build_list_colors" },
      type: {
        kind: "array", count: 10, index_base: 0, index_type: "build_list_color_role",
        element: { type: {
          kind: "array", count: 2, index_base: 0, index_type: "build_list_highlight",
          element: { type: "build_list_color" },
        } },
      },
      default_source: "native",
    },

    build_list_format: {
      title: "Build-list product formatting",
      description: "Configures ordering and reusable color roles for Housing, Trade Goods, and colony buildings.",
      remarks: "Items with equal order are sorted by their localized displayed names. Native defaults preserve the classic list order and colors.",
      examples: [
        "interface build_list_format housing order = -2;",
        "interface build_list_format automated_factory color = accent_1;",
      ],
      group: "synchronized_interface",
      namespace: "interface",
      bind_root: { header: "game/colbldg.h", symbol: "COLBLDG::build_list_format" },
      type: {
        kind: "array", count: 50, index_base: 0, index_type: "build_list_product",
        element: { type: "build_list_format_row" },
      },
      default_source: "native",
    },

    no_outpost_prompt: {
      title: "Skip outpost placement prompts",
      description: "Skips automatic outpost placement prompts when an outpost ship arrives at a star.",
      remarks: "False preserves classic behavior. Colony placement prompts remain available when the player has a colony ship and an eligible planet.",
      examples: ["interface no_outpost_prompt = true;"],
      group: "synchronized_interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/report.h",
        symbol: "REPORT::no_outpost_prompt",
      },
    },
    initial_tech_prompt: {
      title: "Initial research selection prompt",
      description: "Prompts a player with no selected research field to choose one after the first turn.",
      remarks: "True preserves classic behavior. Disabling this suppresses only the initial selection prompt, which is useful for melee games.",
      examples: ["interface initial_tech_prompt = false;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: true,
      bind_root: { header: "game/report.h", symbol: "REPORT::initial_tech_prompt" },
    },

    rebel_display: {
      title: "Rebel troop display",
      description: "Displays the rebel troop picture and combat strength in the colony military popup.",
      remarks: "Rebels use the colony owner's ground-combat modifiers. False preserves the classic three-column popup.",
      examples: ["interface rebel_display = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/newpup.h",
        symbol: "NEWPUP::rebel_display",
      },
    },

    loaded_config_prompt: {
      title: "Loaded configuration prompt",
      description: "Displays the configuration adopted from a loaded saved game when the main screen is reached.",
      remarks: "The prompt identifies active mod packages by their stable package IDs. False suppresses the notification.",
      examples: ["interface loaded_config_prompt = false;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: true,
      bind_root: {
        header: "game/savegame.h",
        symbol: "SAVEGAME::loaded_config_prompt",
      },
    },

    main_menu_mod_list: {
      title: "Main-menu mod list",
      description: "Displays loaded mod names and versions in the main menu and moves the animated credits to a separate screen.",
      remarks: "False preserves the classic animated credits on the main menu. When enabled, select Credits below the ordered mod list to view the original animation.",
      examples: ["interface main_menu_mod_list = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/mainmenu.h",
        symbol: "MAINMENU::show_mod_list",
      },
    },

    keep_end_of_turn_wait_in_multiplayer: {
      title: "Keep End of Turn Wait in multiplayer",
      description: "Keeps the End of Turn Wait option selected when opening game settings in hotseat or network multiplayer games.",
      remarks: "False preserves classic behavior, which clears the option outside a single-player game.",
      examples: ["interface keep_end_of_turn_wait_in_multiplayer = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/loadsave.h",
        symbol: "LOADSAVE::keep_end_of_turn_wait_in_multiplayer",
      },
    },

    allow_future_technology_browsing: {
      title: "Allow future technology browsing",
      description: "Keeps research-category buttons available for browsing technology fields beyond the next research choice.",
      remarks: "True preserves classic behavior. False restores MOO2 1.50's no_future_tech_peek option without retaining its inverse legacy name.",
      examples: ["interface allow_future_technology_browsing = false;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: true,
      bind_root: {
        header: "game/tech.h",
        symbol: "TECH::allow_future_technology_browsing",
      },
    },

    confirm_battle_message_timeout: {
      title: "Battle confirmation message timeout",
      description: "Sets how long battle attack, outpost-destruction, mind-control, and bombardment confirmation messages remain visible.",
      remarks: "Each tick is approximately 55 milliseconds. Zero waits for manual dismissal. The default of 32767 is approximately 30 minutes and matches MOO2 1.50.",
      examples: ["interface confirm_battle_message_timeout = 180;"],
      units: "timer ticks",
      group: "synchronized_interface",
      namespace: "interface",
      type: "uint16",
      default: 32767,
      bind_root: {
        header: "game/combfind.h",
        symbol: "COMBFIND::confirm_battle_message_timeout",
      },
    },

    center_on_next_ship: {
      title: "Center tactical camera on next ship",
      description: "Centers the tactical combat camera when initiative selects the next ship.",
      remarks: "True preserves classic initiative behavior. False retains the non-initiative camera behavior, matching MOO2 1.50's no_center_on_next_ship setting.",
      examples: ["interface center_on_next_ship = false;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: true,
      bind_root: {
        header: "game/combat1.h",
        symbol: "COMBAT1::center_on_next_ship",
      },
    },

    death_spore_list_damage: {
      title: "Show Death Spore damage",
      description: "Shows Death Spore damage instead of the special-effect label in ship-design displays.",
      remarks: "False preserves the classic special-effect label.",
      examples: ["interface death_spore_list_damage = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/design.h",
        symbol: "DESIGN::death_spore_list_damage",
      },
    },

    bio_terminator_list_damage: {
      title: "Show Bio Terminator damage",
      description: "Shows Bio Terminator damage instead of the special-effect label in ship-design displays.",
      remarks: "False preserves the classic special-effect label.",
      examples: ["interface bio_terminator_list_damage = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/design.h",
        symbol: "DESIGN::bio_terminator_list_damage",
      },
    },

    antaran_fortress_armor_multiplier: {
      title: "Antaran Fortress armor multiplier",
      description: "Configures the armor multiplier applied to the Antaran Star Fortress.",
      remarks: "The default of three preserves the independent classic armor multiplier. The configured byte is interpreted as a nonnegative multiplier instead of reproducing signed immediate-byte overflow.",
      examples: ["combat antaran_fortress_armor_multiplier = 3;"],
      group: "gameplay",
      namespace: "combat",
      type: "uint8",
      default: 3,
      bind_root: {
        header: "game/combinit.h",
        symbol: "COMBINIT::antaran_fortress_armor_multiplier",
      },
    },

    main_map_overview_markers: {
      title: "Main-map overview star markers",
      description: "Replaces star pictures with overview-map color markers in the Maximum galaxy's all-stars view.",
      remarks: "Only applies to Maximum galaxies at maximum zoom-out. Player-owned systems use their player color. Unvisited neutral systems use bluish-gray, visited or contested neutral systems use gray, and black holes retain their overview marker. False preserves the normal star pictures.",
      examples: ["interface main_map_overview_markers = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/mainscr.h",
        symbol: "MAINSCR::main_map_overview_markers",
      },
    },

    main_screen_tax_rate: {
      title: "Main-screen tax rate",
      description: "Displays a nonzero tax percentage above the treasury balance on the Main galaxy screen.",
      remarks: "False preserves the classic two-line treasury display. When enabled and tax is nonzero, a third line shows the percentage above BC and income, using the research percentage's base font settings and font-height spacing. Treasury balance, income formatting, and negative-value colors are unchanged. Local to each player, excluded from saves and synchronization.",
      examples: ["interface main_screen_tax_rate = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: { header: "game/mainscr.h", symbol: "MAINSCR::main_screen_tax_rate" },
    },

    maximum_galaxy_zoom_mode: {
      title: "Maximum galaxy zoom mode",
      description: "Selects geometric subdivision or classic display scales for Maximum-galaxy zoom levels.",
      remarks: "Half is the default: each zoom-in step halves the visible width and height, showing one quarter of the previous map area. Classic restores the wider 72-star-style zoom scales.",
      examples: ["interface maximum_galaxy_zoom_mode = classic;"],
      group: "interface",
      namespace: "interface",
      type: "maximum_galaxy_zoom_mode",
      default: "half",
      bind_root: {
        header: "game/map_scale.h",
        symbol: "MAP_SCALE::maximum_galaxy_zoom_mode",
      },
    },

    show_exit_message: {
      title: "Show exit message",
      description: "Shows the localized thank-you message after quitting the game normally.",
      remarks: "Disabled by default. Error messages are shown regardless of this setting. This is a local preference and is not saved or synchronized.",
      examples: ["interface show_exit_message = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/mox2.h",
        symbol: "MOX2::show_exit_message",
      },
    },
  },
}