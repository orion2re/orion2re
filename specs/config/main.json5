        { id: "system_crystal_hydra_dragon", title: "System Crystal, Hydra, and Dragon", description: "Hit points of stationary Crystal, Hydra, and Dragon guardians.", type: "uint16", constraints: { max: 32767 }, bind: ["system_crystal_hydra_dragon"] },
        { id: "event_amoeba", title: "Event Amoeba", description: "Hit points of an Amoeba event monster.", type: "uint16", constraints: { max: 32767 }, bind: ["event_amoeba"] },
