    antaran_offensive: {
      title: "Offensive Antaran ship designs",
      description: "Configures every strategic offensive Antaran ship design by difficulty and hull size.",
      examples: ["ships antaran_offensive impossible titan weapons 8 amount = 12;"],
      group: "gameplay",
      namespace: "ships",
      bind_root: { header: "game/ship_config.h", symbol: "SHIP_CONFIG::antaran_offensive_templates" },
