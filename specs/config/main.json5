    artemis_system_net: {
      title: "Artemis System Net",
      description: "Damage and trigger policy for Artemis System Net attacks in tactical combat.",
      remarks: "The total damage pool is random_total_damage plus minimum_total_damage, decremented by counter after each single_hit_damage application. Counter and single_hit_damage normally match; the classic values do not exactly produce the advertised range. Strategic-combat Artemis damage remains native strategic behavior.",
      fields: [
        { id: "random_total_damage", title: "Random total damage", description: "Exclusive upper bound of the random Artemis damage-pool term.", type: "uint16", bind: ["random_total_damage"] },
        { id: "minimum_total_damage", title: "Minimum total damage", description: "Fixed Artemis damage-pool term.", type: "uint16", bind: ["minimum_total_damage"] },
