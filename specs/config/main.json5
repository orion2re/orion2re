    reject_declined_offers: {
      title: "Keep offer timer after declining a leader",
      description: "Declining an initial leader offer preserves the elapsed wait toward the next offer instead of restarting it.",
      remarks: "A declined leader remains available to hire from the officer screen for 30 turns regardless of this setting. False preserves the classic timer reset. This affects human offers only; accepting a leader into the officer pool still resets the timer, and AI behavior is unchanged.",
      examples: ["leaders reject_declined_offers = true;"],
      group: "gameplay",
      namespace: "leaders",
      type: "bool",
      default: false,
      bind_root: { header: "game/officer.h", symbol: "OFFICER::reject_declined_offers" },
    },

    leaders_no_limit: {
      title: "Unlimited leaders",
      description: "Allows players to employ or retain more than four ship leaders and more than four colony leaders.",
      remarks: "False preserves the classic four-per-type and eight-total limits. True uses the complete 67-entry leader table and enables paging on the officer screen.",
      examples: ["leaders leaders_no_limit = true;"],
      group: "gameplay",
      namespace: "leaders",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/officer.h",
        symbol: "OFFICER::leaders_no_limit",
      },
    },

    skill_cost: {
      title: "Leader skill hire costs",
      description: "Configures each leader skill's contribution to its base hire value.",
      remarks: "The hire price is ten times the resulting base value, scaled by leader level. Costs preserve the native unsigned-byte domain. Improved names identify second-tier skills, and Commando replaces the unused labels from MOO2 1.50.",
      examples: [
        "leaders skill_cost assassin = 2;",
        "leaders skill_cost megawealth_improved = 2;",
      ],
      group: "gameplay",
      namespace: "leaders",
      bind_root: { header: "game/mox.h", symbol: "MOX::skill_data" },
      type: {
        kind: "array", count: 54, index_base: 0, index_type: "leader_skill",
        element: { type: "uint8", bind: ["cost"] },
      },
      default_source: "native",
    },

    commando_hire_cost: {
      title: "Commando hire-cost adjustments",
      description: "Configures the type-specific base hire-cost adjustment applied to each Commando tier.",
      remarks: "Commando and Improved Commando have zero native table cost; Improved Commando applies this adjustment twice. Defaults preserve the original 1 and 3 adjustments.",
      examples: [
        "leaders commando_hire_cost colony = 1;",
        "leaders commando_hire_cost ship = 3;",
