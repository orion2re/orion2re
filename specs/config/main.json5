    ground_commando_defender_x5: {
      title: "Higher defending Commando bonus",
      description: "Uses 5x and 7.5x officer-level multipliers for defending ground troops instead of the classic 2x and 3x multipliers.",
      remarks: "False preserves classic behavior. The improved 7.5x result retains the original 1.50 downward rounding.",
      examples: ["leaders ground_commando_defender_x5 = true;"],
      group: "gameplay",
      namespace: "leaders",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/invasion.h",
        symbol: "invasion::ground_commando_defender_x5",
      },
    },

    invasion: {
      title: "Invasion technology capture chances",
      description: "Configures technology-capture weights for buildings and population after a successful colony invasion.",
      remarks: "At most four technologies are captured. AI weights add five per difficulty level; Average AI therefore uses the player defaults.",
      examples: [
        "combat invasion technology_chance building_player = 125;",
        "combat invasion technology_chance population_ai = 55;",
      ],
      group: "gameplay",
      namespace: "combat",
      type: {
        kind: "record",
        fields: [
          { id: "technology_chance", title: "Technology capture chances", description: "Building and population technology-capture weights.", type: "invasion_technology_chance", bind: ["technology_chance"] },
        ],
      },
      default: {
        technology_chance: {
          building_player: 125,
          building_ai: 115,
          population_player: 65,
          population_ai: 55,
        },
      },
      bind_root: { header: "game/invasion.h", symbol: "invasion::settings" },
    },

    ground_commando_attacker_x2: {
      title: "Lower attacking Commando bonus",
      description: "Uses 2x and 3x officer-level multipliers for attacking ground troops instead of the classic 5x and 7.5x multipliers.",
      remarks: "False preserves classic behavior, including upward rounding of the improved 7.5x result.",
      examples: ["leaders ground_commando_attacker_x2 = true;"],
      group: "gameplay",
      namespace: "leaders",
      type: "bool",
      default: false,
      bind_root: {
