    interactive_combat_stats: {
      title: "Interactive combat statistics",
      description: "Updates ship speed, remaining movement, combat bonuses, initiative, and fleet ordnance as combat state changes within a turn.",
      examples: ["combat interactive_combat_stats = true;"],
      group: "gameplay",
      namespace: "combat",
      type: "bool",
      bind_root: {
        header: "game/combat1.h",
        symbol: "COMBAT1::interactive_combat_stats",
      },
      default: false,
    },

    max_ships_per_side: {
      title: "Maximum tactical ships per side",
      description: "Limits the combat ships admitted from each fleet, largest hulls first.",
      remarks: "The planet and orbital defense are loaded separately. Battles above 100 ships per side expand the battlefield vertically in proportion to the larger admitted fleet, retaining the classic horizontal separation and viewport.",
      examples: ["combat max_ships_per_side = 500;"],
      group: "gameplay",
      namespace: "combat",
      type: "int16",
      constraints: { min: 1, max: 500 },
      default: 100,
      bind_root: { header: "game/combinit.h", symbol: "COMBINIT::max_ships_per_side" },
    },

    max_flyers_per_side: {
      title: "Maximum tactical flyer groups per side",
      description: "Limits each side's active missile, torpedo, fighter, bomber, and assault-shuttle groups.",
      remarks: "Counts groups, not individual projectiles or craft, including those launched by planetary and orbital defenses. The shared total cap also applies. The default 300 imposes no additional restriction on the classic shared 300-slot pool.",
      examples: ["combat max_flyers_per_side = 2500;"],
      group: "gameplay",
      namespace: "combat",
      type: "int16",
      constraints: { min: 1, max: 2500 },
      default: 300,
      bind_root: { header: "game/combinit.h", symbol: "COMBINIT::max_flyers_per_side" },
    },

    max_flyers_total: {
      title: "Maximum tactical flyer groups total",
      description: "Limits active flyer groups shared by both sides in one tactical battle.",
      remarks: "The default 300 preserves the classic shared pool. Set this to 5000 and max_flyers_per_side to 2500 to allow both sides their expanded quota. Either cap can restrict launches independently; freed and merged slots are reusable.",
      examples: ["combat max_flyers_total = 5000;"],
      group: "gameplay",
      namespace: "combat",
      type: "int16",
      constraints: { min: 1, max: 5000 },
      default: 300,
      bind_root: { header: "game/combinit.h", symbol: "COMBINIT::max_flyers_total" },
    },

    ship_initiative: {
      title: "Ship initiative mode",
      description: "Selects the tactical ship initiative and waiting rules.",
      remarks: "Minus one uses the in-game setting. Zero disables initiative, one enables classic initiative, and two enables strict two-stage sequencing.",
      examples: ["combat ship_initiative = 2;"],
      group: "gameplay",
      namespace: "combat",
      type: "int8",
      constraints: { min: -1, max: 2 },
      default: -1,
      bind_root: {
        header: "game/combat1.h",
        symbol: "COMBAT1::ship_initiative",
      },
    },

    wait_movement_cost: {
      title: "Wait movement cost",
      description: "Removes movement points when a ship waits during strict combat sequencing.",
      remarks: "The cost is capped at the ship's remaining movement. Zero preserves classic movement behavior.",
      examples: ["combat wait_movement_cost = 2;"],
      units: "movement points",
      group: "gameplay",
      namespace: "combat",
      type: "uint16",
      default: 0,
      bind_root: {
        header: "game/combat1.h",
        symbol: "COMBAT1::wait_movement_cost",
      },
    },

    ships_without_ammo_stay: {
      title: "Keep automatic ships without ammunition in combat",
      description: "Prevents an FTL-capable ship controlled by AUTO from retreating solely because it has no usable weapons or ammunition.",
      remarks: "False preserves classic automatic retreat. This does not prevent retreat requested by the side's AI posture.",
