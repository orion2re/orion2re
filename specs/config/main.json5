    },

    starbase_special: {
      title: "Orbital-defense special priority",
      description: "Configures the ranked special systems installed on researched orbital defenses.",
      remarks: "Each of the fourteen slots has three ordered alternatives. The first researched alternative in each slot is selected, and at most eight systems are counted including fixed Heavy Armor.",
      examples: [
        "combat starbase_special 6 1 = reflection_field;",
        "combat starbase_special 6 2 = lightning_field;",
        "combat starbase_special 14 1 = warp_dissipator;",
