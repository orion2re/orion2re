    artemis_system_net: {
      title: "Artemis System Net",
      description: "Configures Artemis System Net damage and target trigger chances in tactical combat.",
      remarks: "Strategic-combat Artemis damage uses the native strategic resolver and is not changed by this setting. The default reproduces classic and MOO2 1.50 tactical Artemis behavior.",
      examples: [
        "combat artemis_system_net single_hit_damage = 20;",
        "combat artemis_system_net inherent_modifications = extra_structural_damage;",
        "combat artemis_system_net trigger_chance titan = 80;",
      ],
      group: "gameplay",
      namespace: "combat",
