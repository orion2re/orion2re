        { id: "ammo", title: "Ammunition", description: "Signed ammunition state; minus one is the native unlimited or not-applicable sentinel.", type: "int8", constraints: { min: -1, max: 127 }, bind: ["ammo"] },
        { id: "amount", title: "Amount", description: "Number of weapons installed in this slot.", type: "uint8", constraints: { max: 99 }, bind: ["count", "current_count"] },
      ],
    },
    predefined_ship_design: {
      title: "Predefined ship design",
      description: "Publicly configurable fields copied into a predefined strategic ship.",
