        { id: "emergency_defense", title: "Emergency defense", description: "Ordered defensive preemption policy.", type: "strategic_emergency_defense", bind: ["emergency_defense"] },
        { id: "economic_emergency", title: "Economic emergency", description: "Forced Trade Goods policy.", type: "strategic_economic_emergency", bind: ["economic_emergency"] },
        { id: "expansion", title: "Expansion", description: "Colony Base and Colony Ship policy.", type: "strategic_expansion", bind: ["expansion"] },
        { id: "allocation", title: "Allocation", description: "General weighted strategic selector.", type: "strategic_allocation", bind: ["allocation"] },
      ],
    },
    autobuild_settings: {
      title: "Experimental autobuild settings",
      description: "Controls queue-driven colony autobuild behavior.",
      fields: [
        { id: "enabled", title: "Enabled", description: "Enables queue-driven colony autobuild.", type: "bool", bind: ["enabled"] },
        { id: "default", title: "Default queue", description: "Queue number prefilled when assigning autobuild to a colony.", type: "uint8", constraints: { min: 0, max: 10 }, bind: ["default_preset"] },
      ],
    },
    scan_bonus: {
      title: "Strategic scan bonuses",
      description: "Controls scanner, ship-system, orbital-base, and same-location strategic detection values.",
      fields: [
        { id: "battle_scanner", title: "Battle Scanner", description: "Detection added by a working Battle Scanner.", type: "uint16", constraints: { max: 32767 }, bind: ["battle_scanner"] },
        { id: "scout_lab", title: "Scout Lab", description: "Detection added by a working Scout Lab.", type: "uint16", constraints: { max: 32767 }, bind: ["scout_lab"] },
        { id: "star_base", title: "Star Base", description: "Detection added by a colony Star Base.", type: "uint16", constraints: { max: 32767 }, bind: ["star_base"] },
        { id: "battlestation", title: "Battlestation", description: "Detection added by a colony Battlestation.", type: "uint8", constraints: { max: 127 }, bind: ["battlestation"] },
        { id: "star_fortress", title: "Star Fortress", description: "Detection added by a colony Star Fortress.", type: "uint8", constraints: { max: 127 }, bind: ["star_fortress"] },
        { id: "no_scanner", title: "No scanner", description: "Base detection range without advanced scanner technology.", type: "uint8", constraints: { max: 127 }, bind: ["no_scanner"] },
        { id: "space_scanner", title: "Space Scanner", description: "Detection range with Space Scanner technology.", type: "uint8", constraints: { max: 127 }, bind: ["space_scanner"] },
        { id: "tachyon_scanner", title: "Tachyon Scanner", description: "Detection range with Tachyon Scanner technology.", type: "uint8", constraints: { max: 127 }, bind: ["tachyon_scanner"] },
        { id: "neutron_scanner", title: "Neutron Scanner", description: "Detection range with Neutron Scanner technology.", type: "uint8", constraints: { max: 127 }, bind: ["neutron_scanner"] },
        { id: "sensors", title: "Sensors", description: "Detection range with Sensors technology.", type: "uint8", constraints: { max: 127 }, bind: ["sensors"] },
        { id: "planet", title: "Planet proximity", description: "Detection applied when the target shares a colony's location.", type: "uint16", constraints: { max: 32767 }, bind: ["planet"] },
        { id: "fleet", title: "Fleet proximity", description: "Detection applied when the target shares a friendly fleet's location.", type: "uint16", constraints: { max: 32767 }, bind: ["fleet"] },
      ],
    },
    stealth_bonus: {
