    format: {
      title: "Interface text formats",
      description: "Configures selected interface labels using named placeholders.",
      remarks: "A $NAME$ placeholder is replaced only when its caller supplies NAME; otherwise it remains unchanged. Use $$ for a literal dollar sign.",
      examples: [
        "interface format prod template = \"$TURNS$ turns\";",
        "interface format prod2 template = \"$TOTAL_PROD$ / $PRODUCT_COST$\";",
        "interface format leader_xp template = \"$XP$/$NEXTLVL$ EP\";",
        "interface format race_spies template = \"$SPIES$\";",
