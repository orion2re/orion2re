      },
    },

    ship_explosion: {
      title: "Ship explosion damage",
      description: "Controls drive-based explosion damage and Quantum Detonator amplification.",
      examples: ["combat ship_explosion drive_damage_multiplier = 5;"],
      group: "gameplay",
      namespace: "combat",
      type: {
        kind: "record",
        fields: [
          { id: "drive_damage_multiplier", title: "Drive damage multiplier", description: "Multiplier applied to hull drive hit points for an ordinary ship explosion.", type: "uint8", bind: ["drive_damage_multiplier"] },
          { id: "quantum_detonator_damage_multiplier", title: "Quantum Detonator damage multiplier", description: "Additional multiplier applied to a Quantum Detonator explosion.", type: "uint8", bind: ["quantum_detonator_damage_multiplier"] },
