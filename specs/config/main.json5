  records: {
    spy_success: {
      title: "Spy action success thresholds",
      description: "Minimum spy-roll results for theft, framing, and sabotage outcomes.",
      fields: [
        { id: "steal", title: "Theft", description: "Minimum roll for a successful technology theft.", type: "uint8", constraints: { max: 127 }, bind: ["steal"] },
        { id: "steal_and_frame", title: "Theft with framing", description: "Minimum roll for a theft that frames another player.", type: "uint8", constraints: { max: 127 }, bind: ["steal_and_frame"] },
        { id: "sabotage", title: "Sabotage", description: "Minimum roll for successful sabotage.", type: "uint8", constraints: { max: 127 }, bind: ["sabotage"] },
        { id: "sabotage_and_frame", title: "Sabotage with framing", description: "Minimum roll for sabotage that frames another player.", type: "uint8", constraints: { max: 127 }, bind: ["sabotage_and_frame"] },
      ],
    },
    invasion_technology_chance: {
      title: "Invasion technology capture chances",
      description: "Base weights used when an invasion captures technology from colony buildings or population.",
      fields: [
        { id: "building_player", title: "Player building chance", description: "Technology-capture weight for each conquered building when a human player invades.", type: "uint16", bind: ["building_player"] },
        { id: "building_ai", title: "AI building chance", description: "Base technology-capture weight for each conquered building when an AI player invades.", type: "uint8", bind: ["building_ai"] },
        { id: "population_player", title: "Player population chance", description: "Technology-capture weight for each conquered population unit when a human player invades.", type: "uint16", bind: ["population_player"] },
        { id: "population_ai", title: "AI population chance", description: "Base technology-capture weight for each conquered population unit when an AI player invades.", type: "uint8", bind: ["population_ai"] },
      ],
    },
    spy_count_bonus: {
      title: "Spy count bonuses",
      description: "Spy-count cutoffs for the +2, +1, and paired-spy roll bonuses.",
      fields: [
        { id: "plus_two", title: "Plus-two cutoff", description: "Number of first spies that each add two points to the roll.", type: "uint8", constraints: { max: 127 }, bind: ["plus_two"] },
        { id: "plus_one", title: "Plus-one cutoff", description: "Number of first spies that each add at least one point to the roll.", type: "uint8", constraints: { max: 127 }, bind: ["plus_one"] },
      ],
    },
    spy_random_bonus: {
      title: "Spy random roll bounds",
      description: "Inclusive random-roll bounds added to attacking and defending spy rolls.",
      fields: [
        { id: "attacker", title: "Attacker", description: "Inclusive upper bound of the random value added to an attacking spy roll.", type: "uint32", constraints: { max: 2147483647 }, bind: ["attacker"] },
        { id: "defender", title: "Defender", description: "Inclusive upper bound of the random value subtracted from an attacking spy roll.", type: "uint32", constraints: { max: 2147483647 }, bind: ["defender"] },
      ],
    },
    spy_guaranteed_roll: {
      title: "Guaranteed spy-action rolls",
      description: "Attacker random-roll values that guarantee the corresponding spy action succeeds.",
      fields: [
        { id: "steal", title: "Theft", description: "Attacker random-roll value that guarantees technology theft and theft framing success.", type: "uint8", constraints: { max: 127 }, bind: ["steal"] },
        { id: "sabotage", title: "Sabotage", description: "Attacker random-roll value that guarantees sabotage and sabotage framing success.", type: "uint8", constraints: { max: 127 }, bind: ["sabotage"] },
      ],
    },
    population_bonus: {
      title: "Population bonuses",
      description: "Population-capacity bonuses supplied by technology and colony buildings.",
      fields: [
        { id: "advanced_city_planning", title: "Advanced City Planning", description: "Population capacity added by Advanced City Planning.", type: "uint8", bind: ["advanced_city_planning"] },
        { id: "tolerant", title: "Tolerant", description: "Population-capacity percentage added by the Tolerant racial trait.", type: "int8", bind: ["tolerant"] },
      ],
    },
    map_planet_generation: {
      title: "Generated planet transformations",
      description: "Optional MOO2 1.50 transformations applied to generated planets.",
      fields: [
        { id: "convert_toxic_to_radiated", title: "Convert Toxic to Radiated", description: "Converts generated Toxic planets to Radiated.", type: "bool", bind: ["convert_toxic_to_radiated"] },
        { id: "improve_ultra_poor_minerals", title: "Improve Ultra Poor planets", description: "Improves generated Ultra Poor mineral classes.", type: "bool", bind: ["improve_ultra_poor_minerals"] },
        { id: "normalize_low_gravity", title: "Normalize Low-G planets", description: "Changes uncolonized Low-G planets to Normal-G.", type: "bool", bind: ["normalize_low_gravity"] },
        { id: "normalize_heavy_gravity", title: "Normalize Heavy-G planets", description: "Changes uncolonized Heavy-G planets to Normal-G.", type: "bool", bind: ["normalize_heavy_gravity"] },
        { id: "upgrade_tiny_planets", title: "Upgrade Tiny planets", description: "Replaces generated Tiny planets with larger planets.", type: "bool", bind: ["upgrade_tiny_planets"] },
        { id: "upgrade_small_planets", title: "Upgrade Small planets", description: "Replaces generated Small planets with Medium planets.", type: "bool", bind: ["upgrade_small_planets"] },
      ],
    },
    map_home_system: {
      title: "Home-system generation",
      description: "MOO2 1.50 home-system guarantees and transformations.",
      fields: [
        { id: "minimum_planets", title: "Minimum planets", description: "Minimum planetary bodies in every home system.", type: "uint8", constraints: { min: 1, max: 5 }, bind: ["minimum_planets"] },
        { id: "normalize_unoccupied_planets", title: "Normalize unoccupied planets", description: "Normalizes unoccupied home-system planets while preserving varied climates.", type: "bool", bind: ["normalize_unoccupied_planets"] },
        { id: "use_fixed_unoccupied_planets", title: "Use fixed unoccupied planets", description: "Uses the fixed MOO2 1.50 unoccupied home-system layout.", type: "bool", bind: ["use_fixed_unoccupied_planets"] },
        { id: "improve_fourth_unoccupied_planet", title: "Improve fourth unoccupied planet", description: "Applies the MOO2 1.50 Gaia-or-Terran fourth-planet policy.", type: "bool", bind: ["improve_fourth_unoccupied_planet"] },
        { id: "improve_first_unoccupied_planet", title: "Improve first unoccupied planet", description: "Makes the first unoccupied home-system planet Huge, Rich, and Terran.", type: "bool", bind: ["improve_first_unoccupied_planet"] },
        { id: "make_first_unoccupied_planet_huge", title: "Huge first unoccupied planet", description: "Makes the first unoccupied home-system planet Huge.", type: "bool", bind: ["make_first_unoccupied_planet_huge"] },
        { id: "make_first_unoccupied_planet_rich", title: "Rich first unoccupied planet", description: "Makes the first unoccupied home-system planet Rich.", type: "bool", bind: ["make_first_unoccupied_planet_rich"] },
        { id: "minimum_starting_planet_production", title: "Minimum starting-planet production", description: "Ensures the nearest unoccupied planet yields at least two production for a Normal-G race.", type: "bool", bind: ["minimum_starting_planet_production"] },
        { id: "huge_starting_planet", title: "Huge starting planet", description: "Makes the nearest unoccupied planet Huge with homeworld gravity.", type: "bool", bind: ["huge_starting_planet"] },
        { id: "rich_starting_planet", title: "Rich starting planet", description: "Makes the nearest unoccupied planet Rich unless Ultra Rich is enabled.", type: "bool", bind: ["rich_starting_planet"] },
        { id: "ultra_rich_starting_planet", title: "Ultra Rich starting planet", description: "Makes the nearest unoccupied planet Ultra Rich with homeworld gravity.", type: "bool", bind: ["ultra_rich_starting_planet"] },
      ],
    },
    map_special_generation: {
      title: "Map special generation",
      description: "Generated stellar and planetary special policies.",
      fields: [
        { id: "generate_black_holes", title: "Generate black holes", description: "Allows black holes in generated spectral classes.", type: "bool", bind: ["generate_black_holes"] },
        { id: "generate_wormholes", title: "Generate wormholes", description: "Allows stable wormholes.", type: "bool", bind: ["generate_wormholes"] },
        { id: "generate_nebulas", title: "Generate nebulas", description: "Allows nebulas.", type: "bool", bind: ["generate_nebulas"] },
        { id: "generate_splinter_colonies", title: "Generate Splinter Colonies", description: "Allows unguarded Splinter Colonies.", type: "bool", bind: ["generate_splinter_colonies"] },
        { id: "generate_orion", title: "Generate Orion", description: "Generates the Orion system and Guardian.", type: "bool", bind: ["generate_orion"] },
        { id: "artifacts_grant_technology", title: "Artifacts grant technology", description: "Allows Ancient Artifacts discoveries to grant technology.", type: "bool", bind: ["artifacts_grant_technology"] },
        { id: "replace_splinter_colonies_with_gems", title: "Replace Splinter Colonies", description: "Replaces Splinter Colonies with Gem Deposits after generation.", type: "bool", bind: ["replace_splinter_colonies_with_gems"] },
        { id: "replace_natives_with_gold", title: "Replace Natives", description: "Replaces Natives with Gold Deposits after generation.", type: "bool", bind: ["replace_natives_with_gold"] },
        { id: "highlight_marooned_heroes", title: "Highlight marooned heroes", description: "Uses brown stars only for Marooned Hero systems.", type: "bool", bind: ["highlight_marooned_heroes"] },
        { id: "remove_marooned_heroes", title: "Remove marooned heroes", description: "Replaces assigned Marooned Heroes with Pirate Caches.", type: "bool", bind: ["remove_marooned_heroes"] },
      ],
    },
    map_monster_generation: {
      title: "Map monster generation",
      description: "Natural monster counts and guarded-planet transformations.",
      fields: [
        { id: "count", title: "Preferred monster count", description: "Preferred count; 255 selects the natural random count.", type: "uint8", bind: ["count"] },
        { id: "terraform_guarded_natives", title: "Terraform guarded Natives", description: "Improves poor Native climates in monster systems.", type: "bool", bind: ["terraform_guarded_natives"] },
        { id: "recalculate_guarded_planet_gravity", title: "Recalculate guarded-planet gravity", description: "Recalculates gravity for rich monster-guarded planets.", type: "bool", bind: ["recalculate_guarded_planet_gravity"] },
        { id: "improve_guarded_planets", title: "Improve guarded planets", description: "Normalizes gravity and improves rich guarded planets to at least Terran.", type: "bool", bind: ["improve_guarded_planets"] },
        { id: "natural_chance", title: "Natural monster chance", description: "Per-star natural monster chance by difficulty.", bind: ["natural_chance"], type: { kind: "array", count: 5, index_base: 0, index_type: "game_difficulty", element: { type: "uint8", constraints: { max: 100 } } } },
        { id: "natural_count_cap", title: "Natural monster count cap", description: "Caps randomly generated monsters without limiting an explicit count.", type: "uint8", bind: ["natural_count_cap"] },
      ],
    },
    map_layout: {
      title: "Galaxy layout",
      description: "Map bounds, spacing, display scale, and zoom for one galaxy size.",
      fields: [
        { id: "automatic", title: "Automatic sizing", description: "Derives Maximum geometry from its star count.", type: "bool", bind: ["automatic"] },
        { id: "width", title: "Map width", description: "Unscaled galaxy-map width.", type: "uint16", constraints: { min: 506, max: 32767 }, bind: ["width"] },
        { id: "height", title: "Map height", description: "Unscaled galaxy-map height.", type: "uint16", constraints: { min: 400, max: 32767 }, bind: ["height"] },
        { id: "star_spacing", title: "Star spacing", description: "Generation scale controlling spacing between stars.", type: "uint16", constraints: { min: 1, max: 32767 }, bind: ["star_spacing"] },
        { id: "maximum_display_scale", title: "Maximum display scale", description: "Largest local map display scale.", group: "interface", type: "uint16", constraints: { min: 1, max: 32767 }, bind: ["maximum_display_scale"] },
        { id: "maximum_zoom_level", title: "Maximum zoom level", description: "Largest selectable local zoom level.", group: "interface", type: "uint16", constraints: { max: 3 }, bind: ["maximum_zoom_level"] },
        { id: "initial_zoom_level", title: "Initial zoom level", description: "Local zoom level used when a new game opens.", group: "interface", type: "uint16", constraints: { max: 3 }, bind: ["initial_zoom_level"] },
      ],
    },
    nebula_count_range: {
      title: "Nebula count range",
      description: "Nebula-count range and scaling policy for one galaxy size.",
      fields: [
        { id: "minimum", title: "Minimum nebulas", description: "Minimum generated nebula count.", type: "uint8", constraints: { max: 20 }, bind: ["minimum"] },
        { id: "maximum", title: "Maximum nebulas", description: "Maximum generated nebula count.", type: "uint8", constraints: { max: 20 }, bind: ["maximum"] },
        { id: "scale_with_star_count", title: "Scale with star count", description: "Scales the rolled count for extended galaxies.", type: "bool", bind: ["scale_with_star_count"] },
      ],
    },
    race_primary_pick: {
      title: "Primary racial pick",
      description: "Cost and stored trait value of one primary race-customization choice.",
      fields: [
        {
          id: "cost",
          title: "Pick cost",
          description: "Picks spent or gained by selecting this choice.",
          type: "int8",
          bind: ["cost"],
        },
        {
          id: "value",
          title: "Trait value",
          description: "Value stored in the race trait field. Food and income use native half-unit storage.",
          type: "int8",
          bind: ["value"],
        },
      ],
    },
    race_pick_rules: {
      title: "Race pick rules",
      description: "Budgets, primary choices, governments, and special choices used by race customization.",
      fields: [
        {
          id: "starting",
          title: "Starting picks",
          description: "Picks available before selecting racial options.",
          type: "uint8",
          bind: ["starting"],
        },
        {
          id: "negative_limit",
          title: "Negative-pick limit",
          description: "Lowest permitted subtotal from negative-cost choices.",
          type: "int8",
          bind: ["negative_limit"],
        },
        {
          id: "mutation_bonus",
          title: "Evolutionary Mutation bonus",
          description: "Additional picks granted by Evolutionary Mutation.",
          type: "uint8",
          bind: ["mutation_bonus"],
        },
        {
          id: "primary",
          title: "Primary traits",
          description: "Penalty, bonus, and major-bonus choices for every numeric trait.",
          bind: ["primary"],
          type: {
            kind: "array", count: 9, index_base: 0, index_type: "race_primary_trait",
