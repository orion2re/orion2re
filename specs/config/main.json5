      description: "Identifies one empire-level weighted production action.",
      remarks: "Numeric identities match the existing six-entry strategic selector.",
      kind: "enum", base_type: "uint8",
      values: { combat: 0, freighters: 1, refits: 2, spies: 3, transports: 4, defer: 5 },
    },
    strategic_economic_product: {
      title: "Strategic economic product",
      description: "Selects the internal Trade Goods product used by AI economic emergency policy.",
      remarks: "The value preserves the internal AI Trade Goods marker until turn cleanup.",
      kind: "enum", base_type: "int16",
      values: { trade_goods: -37 },
    },
    strategic_defense_product: {
      title: "Strategic defense product",
      description: "Identifies one building accepted by the emergency-defense production order.",
      remarks: "Values retain native signed 16-bit product storage and building identities.",
      kind: "enum", base_type: "int16",
      values: {
        missile_base: 26, ground_batteries: 27, star_base: 40,
        battlestation: 8, star_fortress: 41, radiation_shield: 28,
        flux_shield: 24, barrier_shield: 23,
