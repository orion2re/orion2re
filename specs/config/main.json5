        housing: 12, trade_goods: 13, freighter_fleet: 14, spy: 15,
        android_farmer: 16, android_worker: 17, android_scientist: 18,
        repeat: 19, colony_ship: 20, outpost_ship: 21, transport: 22,
        design1: 23, design2: 24, design3: 25, design4: 26,
        design5: 27, design6: 28, clear_continuous: 29,
        alien_control_center: 32, armor_barracks: 33, artemis_system_net: 34,
        astro_university: 35, atmosphere_renewer: 36, autolab: 37,
        automated_factory: 38, battlestation: 39, capitol: 40,
        cloning_center: 41, colony_base: 42, deep_core_mine: 43,
        core_waste_dump: 44, dimensional_portal: 45, biospheres: 46,
        food_replicators: 47, gaia_transformation: 48, currency_exchange: 49,
        galactic_cybernet: 50, holo_simulator: 51, hydroponic_farm: 52,
        marine_barracks: 53, barrier_shield: 54, flux_shield: 55,
        gravity_generator: 56, missile_base: 57, ground_batteries: 58,
        radiation_shield: 59, stock_exchange: 60, supercomputer: 61,
        pleasure_dome: 62, pollution_processor: 63, recyclotron: 64,
        robotic_factory: 65, research_lab: 66, robo_miner_plant: 67,
        soil_enrichment: 68, space_academy: 69, spaceport: 70,
        star_base: 71, star_fortress: 72, stellar_converter: 73,
