      remarks: "False preserves classic behavior. This is the restored equivalent of MOO2 1.50's /nohousing ruleset option.",
      examples: ["colony disable_housing = true;"],
      group: "gameplay",
      namespace: "colony",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/colcalc.h",
        symbol: "COLCALC::disable_housing",
