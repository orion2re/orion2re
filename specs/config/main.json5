    antaran_defensive: {
      title: "Defensive Antaran ship designs",
      description: "Configures every tactical defensive Antaran ship design by difficulty and hull size.",
      examples: ["ships antaran_defensive impossible titan weapons 8 amount = 6;"],
      group: "gameplay",
      namespace: "ships",
      bind_root: { header: "game/ship_config.h", symbol: "SHIP_CONFIG::antaran_defensive_templates" },
      type: {
        kind: "array", count: 5, index_base: 0, index_type: "game_difficulty",
        element: { type: { kind: "array", count: 5, index_base: 0, index_type: "antaran_ship_hull_size", element: { type: "predefined_ship_design" } } },
      },
      default_source: "native",
    },
    fortress: {
      title: "Antaran Fortress design",
      description: "Configures the weapons and special systems installed on the Antaran Fortress.",
      remarks: "The four primary allocations own the 1/2, 1/4, 1/4, and 1/2 space calculations. The two overflow weapons receive excess stacks from primary allocations two and three.",
      examples: ["ships fortress primary_weapons 1 weapon type = death_ray;"],
      group: "gameplay",
      namespace: "ships",
      bind_root: { header: "game/ship_config.h", symbol: "SHIP_CONFIG::antaran_fortress" },
      type: {
        kind: "record",
        fields: [
          { id: "primary_weapons", title: "Primary weapons", description: "Four independently budgeted weapon allocations.", bind: ["primary_weapons"], type: { kind: "array", count: 4, index_base: 1, element: { type: "antaran_fortress_primary_weapon" } } },
          { id: "overflow_weapons", title: "Overflow weapons", description: "Weapons used when primary allocations two and three exceed one tactical slot.", bind: ["overflow_weapons"], type: { kind: "array", count: 2, index_base: 1, element: { type: "antaran_fortress_weapon" } } },
          { id: "specials", title: "Special systems", description: "Special systems installed on the Antaran Fortress.", bind: ["specials"], type: { kind: "array", count: 8, index_base: 1, element: { type: "ship_special" } } },
        ],
      },
      default_source: "native",
    },

    star_count: {
      title: "Galaxy star count",
      description: "Sets the number of stars generated for each galaxy-size selection.",
      remarks: "The Maximum layout remains dynamically derived from its star count unless its automatic field is disabled.",
      examples: ["map star_count maximum = 99;"],
      group: "gameplay", namespace: "map",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::star_count_by_galaxy_size" },
      type: { kind: "array", count: 6, index_base: 0, index_type: "galaxy_size", element: { type: "int16", constraints: { min: 3, max: 1023 } } },
      default_source: "native",
    },
    layout: {
      title: "Galaxy layout",
      description: "Configures map bounds, spacing, display scale, and zoom for each galaxy size.",
      remarks: "Maximum uses dynamic sizing by default. Disable automatic only when supplying a complete fixed layout. Display scale and zoom fields are local interface settings and may differ between players.",
      examples: ["map layout maximum automatic = true;"],
      group: "gameplay", namespace: "map",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::layout" },
      type: {
        kind: "array", count: 6, index_base: 0, index_type: "galaxy_size",
        element: { type: "map_layout" },
      },
      default_source: "native",
    },
    planets: {
      title: "Generated planet transformations",
      description: "Applies optional MOO2 1.50 transformations to generated planets.",
      group: "gameplay", namespace: "map",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::planet_generation_config" },
      type: "map_planet_generation",
      default_source: "native",
    },
    home_system: {
      title: "Home-system generation",
      description: "Configures MOO2 1.50 home-system guarantees and transformations.",
      group: "gameplay", namespace: "map",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::home_system_config" },
      type: "map_home_system",
      default_source: "native",
    },
    specials: {
      title: "Map special generation",
      description: "Configures generated stellar and planetary specials.",
      group: "gameplay", namespace: "map",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::special_generation_config" },
      type: "map_special_generation",
      default_source: "native",
    },
    monsters: {
      title: "Map monster generation",
      description: "Configures natural monster counts and guarded-planet transformations.",
      group: "gameplay", namespace: "map",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::monster_generation_config" },
      type: "map_monster_generation",
      default_source: "native",
    },
    planet_limit: {
      title: "Planet trimming threshold",
      description: "Sets the combined planet, asteroid-belt, and gas-giant trimming threshold for galaxies with up to 72 total stars. Zero disables this trimming pass.",
      remarks: "Defaults to 250. Matching MOO2 1.50, all three satellite types count and are eligible for removal; reaching the threshold triggers trimming until the count is below it or no removable objects remain. Home systems, Orion, and required added food-world systems are protected. Galaxies with more than 72 stars use the extended planet capacity instead. This does not change the five-satellite limit per system.",
      examples: ["map planet_limit = 0;", "map planet_limit = 400;"],
      group: "gameplay", namespace: "map", type: "int16",
      constraints: { min: 0, max: 5120 },
      default: 250,
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::planet_limit" },
    },
    starting_reveal_radius: {
      title: "Starting reveal radius",
      description: "Reveals stars within this many thirty-coordinate units of each home system.",
      group: "gameplay", namespace: "map", type: "uint8", default_source: "native",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::starting_reveal_radius" },
    },
    star_visual_size_weight: {
      title: "Star visual-size weights",
      description: "Sets relative generation weights for the three visual star sizes.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::star_visual_size_weight" },
      type: { kind: "array", count: 3, index_base: 0, index_type: "star_visual_size", element: { type: "uint8" } },
    },
    nebula_count: {
      title: "Nebula count range",
      description: "Sets the inclusive generated nebula-count range for each galaxy size.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::nebula_count" },
      type: { kind: "array", count: 6, index_base: 0, index_type: "galaxy_size", element: { type: "nebula_count_range" } },
    },
    star_class_weight: {
      title: "Star-class generation weights", description: "Sets spectral-class weights by galaxy age.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mox.h", symbol: "MOX::star_class_table" },
      type: { kind: "array", count: 7, index_base: 0, index_type: "map_star_class_or_black_hole", element: { type: { kind: "array", count: 3, index_base: 0, index_type: "galaxy_age", element: { type: "uint8" } } } },
    },
    satellite_count: {
      title: "Satellite-count table", description: "Sets generated satellite counts by random roll and star class.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mox.h", symbol: "MOX::class_to_num_satellites" },
      type: { kind: "array", count: 10, index_base: 0, index_type: "random_roll_10", element: { type: { kind: "array", count: 6, index_base: 0, index_type: "map_star_class", element: { type: "int8", constraints: { min: 0, max: 5 } } } } },
    },
    orbit_weight: {
      title: "Satellite orbit weights", description: "Sets orbit-selection weights by galaxy age.",
      group: "gameplay", namespace: "map", default: [[25,20,10],[18,20,22],[17,20,30],[15,20,33],[25,20,5]],
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::satellite_orbit_weight" },
      type: { kind: "array", count: 5, index_base: 0, index_type: "system_orbit", element: { type: { kind: "array", count: 3, index_base: 0, index_type: "galaxy_age", element: { type: "uint8" } } } },
    },
    satellite_type: {
      title: "Satellite-type table", description: "Selects generated satellite types by random roll and orbit.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mox.h", symbol: "MOX::orbit_to_satellite_type" },
      type: { kind: "array", count: 10, index_base: 0, index_type: "random_roll_10", element: { type: { kind: "array", count: 5, index_base: 0, index_type: "system_orbit", element: { type: "map_generation_satellite" } } } },
    },
    planet_size_threshold: {
      title: "Planet-size thresholds", description: "Sets cumulative ten-sided-roll thresholds for generated planet sizes.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mox.h", symbol: "MOX::planet_size_table" },
      type: { kind: "array", count: 5, index_base: 0, index_type: "planet_size", element: { type: "uint8", constraints: { min: 0, max: 10 } } },
    },
    mineral_class: {
      title: "Planet mineral-class table", description: "Selects generated mineral classes by random roll and star class.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::mineral_class" },
      type: { kind: "array", count: 10, index_base: 0, index_type: "random_roll_10", element: { type: { kind: "array", count: 6, index_base: 0, index_type: "map_star_class", element: { type: "mineral_classification" } } } },
    },
    planet_gravity: {
      title: "Generated planet gravity", description: "Selects gravity by mineral class and planet size.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::planet_gravity" },
      type: { kind: "array", count: 5, index_base: 0, index_type: "mineral_classification", element: { type: { kind: "array", count: 5, index_base: 0, index_type: "planet_size", element: { type: "planet_gravity" } } } },
    },
    environment_group: {
      title: "Orbit environmental groups", description: "Selects environmental groups by star class and orbit.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mapgen.h", symbol: "MAPGEN::environment_group" },
      type: { kind: "array", count: 6, index_base: 0, index_type: "map_star_class", element: { type: { kind: "array", count: 5, index_base: 0, index_type: "system_orbit", element: { type: "planet_environment_group" } } } },
    },
    climate_weight_young_average: {
      title: "Young and Average climate weights", description: "Sets climate weights by environmental group for Young and Average galaxies.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mox.h", symbol: "MOX::normal_gal_climate_roll_table" },
      type: { kind: "array", count: 10, index_base: 0, index_type: "planet_climate", element: { type: { kind: "array", count: 4, index_base: 0, index_type: "planet_environment_group", element: { type: "uint8" } } } },
    },
    climate_weight_old: {
      title: "Old climate weights", description: "Sets climate weights by environmental group for Old galaxies.",
      group: "gameplay", namespace: "map", default_source: "native",
      bind_root: { header: "game/mox.h", symbol: "MOX::old_gal_climate_roll_table" },
      type: { kind: "array", count: 10, index_base: 0, index_type: "planet_climate", element: { type: { kind: "array", count: 4, index_base: 0, index_type: "planet_environment_group", element: { type: "uint8" } } } },
    },
    planet_special_chance: {
      title: "Planet-special weighted chances",
      description: "Sets the authoritative weighted-chance table for generated planet and system specials.",
      remarks: "The selector deliberately forces No Special to zero. The unused Orion entry remains a weighted retry outcome.",
      examples: ["map planet_special_chance wormhole = 5;"],
      group: "gameplay", namespace: "map",
      bind_root: { header: "game/mox.h", symbol: "MOX::planet_special_weighted_chance" },
      type: { kind: "array", count: 12, index_base: 0, index_type: "planet_special_chance_index", element: { type: "uint8" } },
      default: [64, 5, 3, 2, 3, 2, 9, 4, 3, 0, 5, 0],
    },
    star_special_chance: {
      title: "Star-special selection threshold",
      description: "Sets the independent threshold for attempting special selection at an eligible star.",
      remarks: "Selection is attempted when Random(100) is greater than this value. The default therefore attempts selection on 36 of 100 possible results.",
      examples: ["map star_special_chance = 64;"],
      group: "gameplay", namespace: "map", type: "uint8", constraints: { max: 100 }, default: 64,
      bind_root: { header: "game/mox.h", symbol: "MOX::planet_special" },
    },

    jump_gate_speed_bonus: {
      title: "Jump Gate speed bonus",
      description: "Adds this speed to fleets traveling through connected Jump Gates.",
      examples: ["movement jump_gate_speed_bonus = 3;"],
      group: "gameplay",
      namespace: "movement",
      type: "uint8",
      default: 3,
      bind_root: {
        header: "game/shipmove.h",
        symbol: "SHIPMOVE::jump_gate_speed_bonus",
      },
    },

    warp_interdictor_range: {
      title: "Warp Interdictor range",
      description: "Sets the squared galaxy-coordinate radius within which an enemy Warp Interdictor stops fleet movement.",
      remarks: "The default 8100 is 90 squared, equivalent to three parsecs at 30 coordinates per parsec.",
      examples: ["movement warp_interdictor_range = 8100;"],
      units: "squared galaxy coordinates",
      group: "gameplay",
      namespace: "movement",
      type: "uint16",
      default: 8100,
      bind_root: {
        header: "game/shipmove.h",
        symbol: "SHIPMOVE::warp_interdictor_range",
      },
    },

    ship_communication_range: {
      title: "Ship communication range",
      description: "Sets the distance from an owned relay system at which a moving ship can receive orders.",
      remarks: "Tachyon Communications and Sub-Space Communications use their own relay ranges; Hyperspace Communications remains unrestricted.",
      examples: [
        "movement ship_communication_range tachyon = 3;",
        "movement ship_communication_range sub_space = 6;",
      ],
      units: "parsecs",
      group: "gameplay",
      namespace: "movement",
      type: {
        kind: "record",
        fields: [
          { id: "tachyon", title: "Tachyon Communications", description: "Maximum Tachyon Communications relay range.", type: "uint8", bind: ["tachyon"] },
          { id: "sub_space", title: "Sub-Space Communications", description: "Maximum Sub-Space Communications relay range.", type: "uint8", bind: ["sub_space"] },
        ],
