{
  // Declaration order is public traversal order. This bootstrap contains only
  // primitive scalar settings already present in the restored game.
  groups: {
    interface: {
      title: "Interface",
      description: "Local presentation and control settings.",
      save: false,
      synchronize: false,
    },
    gameplay: {
      title: "Gameplay",
      description: "Deterministic gameplay definitions shared by all players.",
      save: true,
      synchronize: true,
    },
    technology: {
      title: "Technology",
      description: "Deterministic technology and design tables with independently managed names.",
      save: true,
      synchronize: true,
    },
    synchronized_interface: {
      title: "Synchronized interface",
      description: "Presentation policies selected by the multiplayer host.",
      save: false,
      synchronize: true,
    },
    saved_interface: {
      title: "Saved interface",
      description: "Presentation settings retained by saved games.",
      save: true,
      synchronize: false,
    },
  },

  documentation_categories: {
    interface_and_presentation: {
      title: "Interface and presentation",
      description: "Local controls, display options, and presentation behavior.",
      namespaces: ["interface"],
    },
    new_game_and_races: {
      title: "New game and races",
      description: "Starting conditions, race customization, and initial game setup.",
      namespaces: ["game", "race"],
    },
    colonies_and_economy: {
      title: "Colonies and economy",
      description: "Population, production, buildings, and economic rules.",
      namespaces: ["colony", "economy"],
    },
    tactical_combat: {
      title: "Tactical combat",
      description: "Rules used during tactical battles.",
      namespaces: ["combat"],
    },
    ships_fleets_and_movement: {
      title: "Ships, fleets, and movement",
      description: "Ship definitions, command, travel, and strategic detection.",
      namespaces: ["ships", "movement", "command", "detection"],
    },
    technology_and_ship_design: {
      title: "Technology and ship design",
      description: "Research, technology data, component tables, and design rules.",
      namespaces: ["technology", "research", "design"],
    },
    ai_and_diplomacy: {
      title: "AI and diplomacy",
      description: "Computer-player behavior and diplomatic rules.",
      namespaces: ["ai", "diplomacy"],
    },
    espionage: {
      title: "Espionage",
      description: "Spy bonuses, action resolution, theft, and framing.",
      namespaces: ["spy"],
    },
    leaders_and_officers: {
      title: "Leaders and officers",
      description: "Leader progression, hiring, skills, and special behavior.",
      namespaces: ["leaders"],
    },
    galaxy_and_events: {
      title: "Galaxy and events",
      description: "Galaxy generation, stellar systems, and random events.",
      namespaces: ["map", "events"],
    },
    government_and_victory: {
      title: "Government and victory",
      description: "Government-wide rules, Council behavior, and scoring.",
      namespaces: ["government", "gameplay", "score"],
    },
    experimental: {
      title: "Experimental",
      description: "Features that remain experimental and may change.",
      namespaces: ["experiment"],
    },
  },

  types: {
    // New-game setup domains. These are complete closed sets stored as bytes.
    game_difficulty: {
      title: "Game difficulty",
      description: "Difficulty selected when a new game is created.",
      remarks: "Complete uint8 domain. Numeric configuration preserves the native values 0 through 4.",
      kind: "enum",
      base_type: "int8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { tutor: 0, easy: 1, average: 2, hard: 3, impossible: 4 },
    },
    starting_civilization_level: {
      title: "Starting civilization level",
      description: "Technology level selected when a new game is created.",
      remarks: "Complete native starting-civilization domain.",
      kind: "enum",
      base_type: "uint8",
      values: { prewarp: 0, average: 1, advanced: 2, postwarp: 3 },
    },
    antaran_civilization_band: {
      title: "Antaran civilization band",
      description: "Selects the starting-civilization band used for Antaran growth delay.",
      remarks: "Post-Warp uses the Average band, matching other classic-rule normalization.",
      kind: "enum",
      base_type: "uint8",
      values: { prewarp: 0, average: 1, advanced: 2 },
    },
    antaran_difficulty_band: {
      title: "Antaran difficulty band",
      description: "Selects the difficulty band used by Antaran resource and retirement policy.",
      remarks: "Tutor and Easy use the Normal band, matching the original Antaran rules.",
      kind: "enum",
      base_type: "uint8",
      values: { normal: 0, hard: 1, impossible: 2 },
    },
    antaran_ship_class: {
      title: "Antaran ship class",
      description: "Selects one strategic Antaran ship class.",
      remarks: "Names preserve the Antaran fleet terminology used by MOO2 1.50.",
      kind: "enum",
      base_type: "uint8",
      values: {
        raider: 0,
        marauder: 1,
        intruder: 2,
        interdictor: 3,
        harbinger: 4,
      },
    },
    antaran_retirement_class: {
      title: "Antaran retirement class",
      description: "Selects the low-tier Antaran ship class governed by a retirement policy.",
      remarks: "Raiders use the original Frigate retirement formula and Marauders use the original Destroyer formula.",
      kind: "enum",
      base_type: "uint8",
      values: { raider: 0, marauder: 1 },
    },
    galaxy_age: {
      title: "Galaxy age",
      description: "Stellar age distribution selected for map generation.",
      remarks: "Complete uint8 domain. Numeric configuration preserves the native values 0 through 2.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { young: 0, average: 1, old: 2 },
    },
    galaxy_size: {
      title: "Galaxy size",
      description: "Map-size selection used by new-game setup.",
      remarks: "Player-selectable sizes use values 0 through 4. Native value 5 is retained only for legacy data and saved games.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { small: 0, medium: 1, large: 2, huge: 3, maximum: 4 },
    },
    maximum_galaxy_zoom_mode: {
      title: "Maximum galaxy zoom mode",
      description: "Selects how visible map dimensions change between zoom levels in Maximum galaxies.",
      remarks: "Half halves both visible dimensions at each step, showing one quarter as much map area. Classic uses the wider 15, 20, and 30 display scales associated with the 72-star map.",
      kind: "enum",
      base_type: "uint8",
      values: { half: 0, classic: 1 },
    },

    // Race and leadership domains. Stock race is a table index, not ownership.
    government: {
      title: "Government",
      description: "A race's base or advanced form of government.",
      remarks: "Complete uint8 semantic-ID domain. The advanced form of each base government has its own native value.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        feudal: 0,
        confederation: 1,
        dictatorship: 2,
        imperium: 3,
        democracy: 4,
        federation: 5,
        unification: 6,
        galactic_unification: 7,
      },
    },
    government_family: {
      title: "Government family",
      description: "Groups each base government with its advanced form for shared morale rules.",
      remarks: "The three values select Feudal and Confederation, Dictatorship and Imperium, or Democracy and Federation.",
      kind: "enum",
      base_type: "uint8",
      values: {
        feudal_confederation: 0,
        dictatorship_imperium: 1,
        democracy_federation: 2,
      },
    },
    race_primary_trait: {
      title: "Primary racial trait",
      description: "Identifies a numeric three-choice racial trait.",
      remarks: "Complete race-customization primary-trait table-index domain.",
      kind: "enum",
      base_type: "uint8",
      values: {
        growth: 0,
        food: 1,
        production: 2,
        research: 3,
        income: 4,
        ship_defense: 5,
        ship_attack: 6,
        ground_combat: 7,
        spying: 8,
      },
    },
    race_primary_choice: {
      title: "Primary racial trait choice",
      description: "Identifies the penalty, bonus, or major-bonus choice for a primary trait.",
      remarks: "Complete three-choice table-index domain.",
      kind: "enum",
      base_type: "uint8",
      values: { penalty: 0, bonus: 1, major_bonus: 2 },
    },
    race_base_government: {
      title: "Selectable base government",
      description: "Identifies one government available during race customization.",
      remarks: "Base governments are contiguous choices here even though native government values interleave advanced forms.",
      kind: "enum",
      base_type: "uint8",
      values: { feudal: 0, dictatorship: 1, democracy: 2, unification: 3 },
    },
    race_special_choice: {
      title: "Special racial choice",
      description: "Identifies one special choice on the race customization screen.",
      remarks: "Choices are distinct from saved trait fields; Rich and Poor Home World share one signed native field.",
      kind: "enum",
      base_type: "uint8",
      values: {
        low_gravity: 0,
        high_gravity: 1,
        aquatic: 2,
        subterranean: 3,
        large_home_world: 4,
        rich_home_world: 5,
        poor_home_world: 6,
        artifacts_home_world: 7,
        cybernetic: 8,
        lithovore: 9,
        repulsive: 10,
        charismatic: 11,
        uncreative: 12,
        creative: 13,
        tolerant: 14,
        fantastic_traders: 15,
        telepathic: 16,
        lucky: 17,
        omniscient: 18,
        stealthy_ships: 19,
        trans_dimensional: 20,
        warlord: 21,
      },
    },
    ratio16: {
      title: "16-bit ratio",
      description: "A signed fractional value written as numerator/denominator.",
      remarks: "Used for exact gameplay fractions whose numerator and denominator fit signed 16-bit storage.",
      kind: "ratio",
      component_type: "int16",
    },
    stock_race_index: {
      title: "Stock race table index",
      description: "Index into the thirteen-entry table of predefined races.",
      remarks: "Complete uint8 index domain. Do not use for player ownership, packed population race data, Androids, natives, or custom-race selections.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        alkari: 0,
        bulrathi: 1,
        darlok: 2,
        elerian: 3,
        gnolam: 4,
        human: 5,
        klackon: 6,
        meklar: 7,
        mrrshan: 8,
        psilon: 9,
        sakkra: 10,
        silicoid: 11,
        trilarian: 12,
      },
    },
    diplomacy_race_index: {
      title: "Diplomacy race table index",
      description: "Index into the fourteen-row starting-relations table.",
      remarks: "The first thirteen rows are stock races. Custom is the native fourteenth race slot.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        alkari: 0,
        bulrathi: 1,
        darlok: 2,
        elerian: 3,
        gnolam: 4,
        human: 5,
        klackon: 6,
        meklar: 7,
        mrrshan: 8,
        psilon: 9,
        sakkra: 10,
        silicoid: 11,
        trilarian: 12,
        custom: 13,
      },
    },
    ai_race_variant_difficulty: {
      title: "AI race-variant difficulty",
      description: "Selects the Hard or Impossible row for an AI stock-race variant.",
      remarks: "The table applies only at these two difficulties.",
      kind: "enum",
      base_type: "uint8",
      values: { hard: 0, impossible: 1 },
    },
    player_personality: {
      title: "AI personality",
      description: "Selects one diplomatic personality assigned to an AI player.",
      remarks: "Dishonored is a runtime diplomacy state and is retained as a valid native value, although the stock personality table does not assign it by default.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        xenophobic: 0,
        ruthless: 1,
        aggressive: 2,
        erratic: 3,
        honorable: 4,
        pacifist: 5,
        dishonored: 6,
      },
    },
    stock_race_pick_choice: {
      title: "Stock-race pick choice",
      description: "Option index used by a stock race's numeric racial pick.",
      remarks: "Zero selects no pick; values one through three select the available penalty or bonus levels for that trait.",
      kind: "alias",
      type: "int8",
      constraints: { min: 0, max: 3 },
    },
    ai_race_trait: {
      title: "AI race trait",
      description: "One native trait-table index used by an AI race variant.",
      remarks: "Complete native player-trait domain. Home World Richness is the signed slot used for both Rich and Poor Home World.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        government: 0,
        growth: 1,
        food: 2,
        production: 3,
        research: 4,
        income: 5,
        ship_defense: 6,
        ship_attack: 7,
        ground_combat: 8,
        spying: 9,
        low_gravity: 10,
        high_gravity: 11,
        aquatic: 12,
        subterranean: 13,
        large_home_world: 14,
        home_world_richness: 15,
        artifacts_home_world: 16,
        cybernetic: 17,
        lithovore: 18,
        repulsive: 19,
        charismatic: 20,
        uncreative: 21,
        creative: 22,
        tolerant: 23,
        fantastic_traders: 24,
        telepathic: 25,
        lucky: 26,
        omniscient: 27,
        stealthy_ships: 28,
        trans_dimensional: 29,
        warlord: 30,
      },
    },
    crew_quality: {
      title: "Crew quality",
      description: "Experience rank assigned to a ship's crew.",
      remarks: "Complete uint8 ordered domain from green through ultra elite.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { green: 0, regular: 1, veteran: 2, elite: 3, ultra_elite: 4 },
    },
    leader_type: {
      title: "Leader type",
      description: "Determines whether a leader commands ships or administers colonies.",
      remarks: "Complete uint8 semantic-ID domain. This does not describe leader employment status.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { ship: 0, colony: 1 },
    },
    leader_skill: {
      title: "Leader skill",
      description: "Identifies one leader skill's base hire-cost entry.",
      remarks: "The order and numeric identities match the native 54-entry skill table. Improved names identify the second tier of a skill.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        assassin: 0, assassin_improved: 1, commando: 2, commando_improved: 3,
        diplomat: 4, diplomat_improved: 5, engineer: 6, engineer_improved: 7,
        environmentalist: 8, environmentalist_improved: 9, famous: 10, famous_improved: 11,
        farming_leader: 12, farming_leader_improved: 13, fighter_pilot: 14, fighter_pilot_improved: 15,
        financial_leader: 16, financial_leader_improved: 17, galactic_lore: 18, galactic_lore_improved: 19,
        helmsman: 20, helmsman_improved: 21, instructor: 22, instructor_improved: 23,
        labor_leader: 24, labor_leader_improved: 25, medicine: 26, medicine_improved: 27,
        megawealth: 28, megawealth_improved: 29, navigator: 30, navigator_improved: 31,
        operations: 32, operations_improved: 33, ordnance: 34, ordnance_improved: 35,
        researcher: 36, researcher_improved: 37, science_leader: 38, science_leader_improved: 39,
        security: 40, security_improved: 41, spiritual_leader: 42, spiritual_leader_improved: 43,
        spy_master: 44, spy_master_improved: 45, tactics: 46, tactics_improved: 47,
        telepath: 48, telepath_improved: 49, trader: 50, trader_improved: 51,
        weaponry: 52, weaponry_improved: 53,
      },
    },
    text_format_row: {
      title: "Text format row",
      description: "Identifies a configurable interface text label.",
      remarks: "Configurable interface labels, including the five-row MOO2 1.50 format domain and restored screen overlays.",
      kind: "enum",
      base_type: "uint8",
      values: { mod_name: 0, version: 1, prod: 2, prod2: 3, leader_xp: 4, race_spies: 5 },
    },
    text_alignment: {
      title: "Text alignment",
      description: "Selects left, right, or centered text placement.",
      remarks: "Complete MOO2 1.50 text alignment domain.",
      kind: "enum",
      base_type: "uint8",
      values: { l: 0, r: 1, c: 2 },
    },
    print_research_value: {
      title: "Empire Info research value",
      description: "Selects the research value displayed in the Colonies screen Empire Info panel.",
      remarks: "Complete MOO2 1.50 interface domain. Classic preserves the original per-turn research display.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        classic: 0,
        accumulated: 1,
        remaining: 2,
        percentage1: 3,
        percentage2: 4,
      },
    },
    info_menu_layout: {
      title: "Empire Info menu layout",
      description: "Selects the tab layout used by the Empire Info screen.",
      remarks: "ice requires a matching alternate INFO.LBX resource supplied through the VFS.",
      kind: "enum",
      base_type: "uint8",
      values: { classic: 0, ice: 1 },
    },
    present_scaler: {
      title: "Presentation scaler",
      description: "Selects the filter used to scale the game framebuffer for display.",
      remarks: "Pixelart and bilinear use SDL texture filtering. HQx and MMPX use CPU edge-aware scaling before texture upload. Internal values 6 through 10 remain unused to preserve the MMPX4 identity.",
      kind: "enum",
      base_type: "uint8",
      values: {
        pixelart: 0, bilinear: 1,
        hq2x: 2, hq3x: 3, hq4x: 4,
        mmpx2: 5,
        mmpx4: 11,
      },
    },
    ship_scrap_refund_percent: {
      title: "Ship scrap refund percentage",
      description: "Selects the percentage of a ship's original production cost returned when it is scrapped at an owned colony.",
      remarks: "Classic returns 25 percent. Double returns 50 percent, matching MOO2 1.50's double_ship_scrap_value setting.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: { classic: 25, double: 50 },
    },

    // Strategic data-table classifications.
    strategic_special_category: {
      title: "Strategic special category",
      description: "AI-oriented category describing the strategic effect of a ship special.",
      remarks: "Complete uint8 semantic-ID domain. Values are categories, not SPECIAL IDs or a bit mask.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        none: 0,
        beam_accuracy: 1,
        beam_damage: 2,
        beam_defense: 3,
        missile_defense: 4,
        missile_damage: 5,
        beam_missile_defense: 6,
        beam_missile_damage: 7,
      },
    },
    technology_application_type: {
      title: "Technology application type",
      description: "Classifies the native object produced by a technology application.",
      remarks: "Complete uint8 semantic-ID domain. Value 6 is reserved and remains valid for native compatibility; this is not the application ai_group field.",
      kind: "enum",
      base_type: "uint8",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        unclassified: { value: 0, description: "No specific application category is assigned." },
        building: { value: 1, description: "The application unlocks a colony building." },
        shield: { value: 2, description: "The application unlocks a ship shield." },
        weapon: { value: 3, description: "The application unlocks a ship weapon." },
        fuel: { value: 4, description: "The application improves ship fuel range." },
        drive: { value: 5, description: "The application unlocks a ship drive." },
        reserved_6: { value: 6, description: "Reserved native category retained for compatibility; do not assign it to new applications." },
        armor: { value: 7, description: "The application unlocks ship armor." },
        computer: { value: 8, description: "The application unlocks a targeting computer." },
        special: { value: 9, description: "The application unlocks a ship special system." },
      },
    },
    technology_status: {
      title: "Technology status",
      description: "Describes a player's semantic relationship to one technology application.",
      remarks: "These stable Lua-facing values intentionally do not match every native technology status byte.",
      kind: "enum",
      base_type: "uint8",
      values: {
        unavailable: 0,
        available: 1,
        researched: 2,
      },
    },
    technology_application: {
      title: "Technology application",
      description: "Identifies one entry in the native technology application table.",
      remarks: "Complete 212-entry MOO2 1.50 domain. Names preserve the public 1.50 tech_mini vocabulary even where restored C++ constants use a different spelling.",
      kind: "enum",
      base_type: "uint16",
      allow_numeric: true,
      reject_unknown_numeric: true,
      values: {
        no_tech: 0, achilles_targeting_unit: 1, adamantium_armor: 2, advanced_city_planning: 3,
        advanced_damage_control: 4, alien_management_center: 5, android_farmers: 6, android_scientists: 7,
        android_workers: 8, anti_grav_harness: 9, anti_matter_bomb: 10, anti_matter_drive: 11,
        anti_matter_torpedo: 12, anti_missile_rocket: 13, armor_barracks: 14, artemis_system_net: 15,
