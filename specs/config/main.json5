    alternative_refit: {
      title: "Alternative refit cost",
      description: "Uses the alternative ship-refit cost formula.",
      remarks: "False uses max(2 * delta, minimum cost). True uses max(delta, 0) plus the minimum cost. Delta is new design cost minus old design cost, and the minimum is one quarter of standard hull cost after government reduction.",
      examples: ["design alternative_refit = true;"],
      group: "gameplay",
      namespace: "design",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/design_config.h",
        symbol: "DESIGN::alternative_refit",
      },
    },

    miniaturization: {
      title: "Miniaturization curves",
      description: "Configures ship-component cost percentages and category-specific space multipliers for miniaturization levels 0 through 5.",
      remarks: "Conversion note for MOO2 1.50 CFG files: level_0_cost through level_5_cost become cost positions 0 through 5. level_0_size_groups_1_and_2 becomes position 0 of both group1 and group2; level_1_size_groups_1_and_2 becomes position 1 of both curves; level_2_size_group_1 becomes group1 position 2; level_3_grp_1_and_level_4_grp_2 becomes group1 position 3 and group2 position 4; level_4_size_group_1 and level_5_size_group_1 become group1 positions 4 and 5; level_2_size_group_2, level_3_size_group_2, and level_5_size_group_2 become group2 positions 2, 3, and 5. Group3 was implicit in 1.50 and its equivalent non-miniaturizing curve is 1000 1000 1000 1000 1000 1000. Curve positions are levels 0 through 5, and position 5 also applies above level 5. Cost values are percentages and space values are per-thousand multipliers. tech_mini assignments retain their 1.50 syntax and names.",
      examples: [
        "design miniaturization cost = 100 75 55 40 30 25;",
        "design miniaturization space group1 = 1000 800 650 500 350 250;",
        "design miniaturization space group2 = 1000 800 700 600 500 400;",
        "design miniaturization space group3 = 1000 1000 1000 1000 1000 1000;",
      ],
      group: "gameplay",
      namespace: "design",
      type: "miniaturization_settings",
      bind_root: { header: "game/design_config.h", symbol: "DESIGN::miniaturization" },
      default_source: "native",
    },

