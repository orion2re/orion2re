    leader_warlord_bonus: {
      title: "Warlord bonus for leaders",
      description: "Raises Warlord leaders' effective level by one at every XP tier without changing their experience.",
      remarks: "False preserves classic behavior, where Warlord grants the extra level only at 1000 XP.",
      examples: ["leaders leader_warlord_bonus = true;"],
      group: "gameplay",
      namespace: "leaders",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/officer.h",
        symbol: "OFFICER::leader_warlord_bonus",
      },
