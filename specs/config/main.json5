      },
    },
    population_capacity_table_enabled: {
      title: "Use population capacity tables",
      description: "Uses direct climate-by-size population capacities instead of the size and climate formula.",
      remarks: "False preserves existing mod behavior. When true, normal races use population_capacity_table and Tolerant races and Androids use population_capacity_table_tolerant. Aquatic climate adjustments occur before lookup; Subterranean, technology, and building bonuses are added afterward, with the final colony limit capped at 42. Legacy size settings still govern Artificial Planet initialization and absolute troop limits.",
      examples: ["colony population_capacity_table_enabled = true;"],
      group: "gameplay",
      namespace: "colony",
      type: "bool",
      default: false,
      bind_root: { header: "game/colcalc.h", symbol: "COLCALC::population_capacity_table_enabled" },
    },
    population_capacity_table: {
