    orion_reward_technology: {
      title: "Orion reward technology",
      description: "Selects the guaranteed technology granted for defeating Orion before additional random rewards.",
      remarks: "The technology must be a nonzero application. Death Ray preserves classic behavior and the MOO2 1.50 default.",
