    reinforced_hull_multiplier: {
      title: "Reinforced Hull multipliers",
      description: "Configures the structure multiplier for Reinforced Hull orbital defenses.",
      remarks: "The regular multiplier applies only when an orbital defense has Reinforced Hull. The Antaran Fortress multiplier applies only to structure; combat.antaran_fortress_armor_multiplier controls its armor independently. Configured bytes are interpreted as nonnegative multipliers instead of reproducing signed immediate-byte overflow.",
      examples: [
        "combat reinforced_hull_multiplier regular_satellites = 3;",
        "combat reinforced_hull_multiplier antaran_fortress = 3;",
