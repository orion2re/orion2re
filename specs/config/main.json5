  parameters: {
    router: {
      title: "Online router endpoint",
      description: "Sets the router used for online multiplayer games.",
      remarks: "Online play fails with configuration instructions when this is empty. Use a DNS name or IPv4 address followed by an optional port; the default port is 47800. LAN games use discovery and ignore this setting.",
      examples: ["interface router = \"router.example.com:47800\";"],
      group: "interface",
      namespace: "interface",
      type: "string",
      constraints: { max_length: 69 },
      default: "",
      bind_root: {
        header: "game/multplay.h",
        symbol: "MULTPLAY::router_endpoint",
      },
    },

    picks: {
      title: "Race pick rules",
      description: "Configures race customization budgets, costs, and primary-trait values.",
      remarks: "Defaults preserve classic behavior. Food and income trait values use signed half-unit storage, so one represents one half.",
      examples: [
        "race picks starting = 10;",
        "race picks primary growth major_bonus cost = 6;",
        "race picks primary growth major_bonus value = 100;",
        "race picks government democracy = 7;",
        "race picks special subterranean = 6;",
      ],
      group: "gameplay",
      namespace: "race",
      type: "race_pick_rules",
      bind_root: { header: "game/raceopt.h", symbol: "raceopt::pick_rules" },
      default_source: "native",
    },

    scroll_interval: {
      title: "Tactical combat scroll interval",
      description: "Sets the minimum interval between tactical-combat edge-scroll events.",
      remarks: "Each tick is approximately 55 milliseconds. Zero restores classic unrestricted scrolling.",
      examples: ["interface scroll_interval = 1;"],
      units: "timer ticks",
      group: "interface",
      namespace: "interface",
      type: "uint8",
      default: 1,
      bind_root: {
        header: "game/combinit.h",
        symbol: "COMBINIT::scroll_interval",
      },
    },

    progression: {
      title: "Leader progression",
      description: "Configures leader experience thresholds, availability, hire chances, and special leader IDs.",
      remarks: "The availability increment must be nonzero. Special leader IDs use the complete unsigned-byte domain; values outside the restored 67-entry table safely disable the corresponding special case.",
      examples: [
        "leaders progression experience_thresholds 2 = 60;",
        "leaders progression availability increment_step = 5;",
        "leaders progression special_leaders advanced_government_leader_id = 47;",
      ],
      group: "gameplay",
      namespace: "leaders",
      type: "leader_progression",
      bind_root: { header: "game/officer.h", symbol: "OFFICER::progression" },
      default: {
        experience_thresholds: [60, 150, 300, 500, 1000],
        availability: { base_amount: 10, increment_step: 5, charismatic_bonus: 10 },
        hire_chance: { initial_delay: 5, charismatic_bonus: 5, repulsive_penalty: 10 },
        special_leaders: { advanced_government_leader_id: 47, random_skills_colony_leader_id: 41, random_skills_ship_officer_id: 52 },
      },
    },

    scaler: {
      title: "Presentation scaler",
      description: "Selects the filter used to scale the game framebuffer to the window.",
      remarks: "Pixelart preserves the current SDL pixel-art presentation and is the default. CPU scalers use dirty-region processing; higher factors increase worst-case CPU and texture-upload cost.",
      examples: ["interface scaler = mmpx2;", "interface scaler = mmpx4;"],
      group: "interface",
      namespace: "interface",
      type: "present_scaler",
      default: "pixelart",
      bind_root: {
        header: "game/platform.h",
        symbol: "platform::g_present_scaler",
      },
    },

    window_width: {
      title: "Window width",
      description: "Sets the initial width of the game window.",
      remarks: "Changes take effect the next time the game starts. The internal game image remains 640 by 480; fullscreen uses the desktop resolution.",
      examples: ["interface window_width = 1280;"],
      group: "interface",
      namespace: "interface",
      type: "int32",
      constraints: { min: 1, max: 16384 },
      default: 640,
      bind_root: { header: "game/platform.h", symbol: "platform::g_window_width" },
    },

    window_height: {
      title: "Window height",
      description: "Sets the initial height of the game window.",
      remarks: "Changes take effect the next time the game starts. The internal game image remains 640 by 480; fullscreen uses the desktop resolution.",
      examples: ["interface window_height = 960;"],
      group: "interface",
      namespace: "interface",
      type: "int32",
      constraints: { min: 1, max: 16384 },
      default: 480,
      bind_root: { header: "game/platform.h", symbol: "platform::g_window_height" },
    },

    fullscreen: {
      title: "Start in fullscreen",
      description: "Starts the game in fullscreen instead of a resizable window.",
      remarks: "Changes take effect the next time the game starts. Fullscreen uses the desktop resolution. Alt+Enter still toggles fullscreen without changing this setting.",
      examples: ["interface fullscreen = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: { header: "game/platform.h", symbol: "platform::g_fullscreen" },
    },

    vsync_enabled: {
      title: "Vertical synchronization",
      description: "Synchronizes rendered frames with the display refresh rate.",
      remarks: "True preserves the restored renderer's default behavior. Disabling synchronization can make screen transitions faster but may cause tearing.",
      examples: ["interface vsync_enabled = false;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: true,
      bind_root: {
        header: "game/platform.h",
        symbol: "platform::g_vsync_enabled",
      },
    },

    net_debug_enabled: {
      title: "Network debug logging",
      description: "Logs low-level game packet events and multiplayer Lua startup waits.",
      remarks: "Local to each peer, excluded from saves and network synchronization. Defaults to false in all builds; changes take effect when configuration is loaded or reloaded.",
      examples: ["interface net_debug_enabled = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/netmox.h",
        symbol: "NETMOX::net_debug_enabled",
      },
    },

    debugger_enabled: {
      title: "In-game debugger",
      description: "Enables the Dear ImGui debugging interface and its F10 toggle.",
      remarks: "False prevents the debugger from opening or capturing input. Changes take effect the next time the game starts.",
      examples: ["interface debugger_enabled = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/debug_overlay.h",
        symbol: "debug_overlay::g_enabled",
      },
    },

    debugger_font_size: {
      title: "In-game debugger font size",
      description: "Sets the Dear ImGui debugger base font size relative to the rest of the interface.",
      remarks: "The UI scale also scales text; change this only to adjust text relative to other debugger elements. Changes take effect the next time the game starts.",
      examples: ["interface debugger_font_size = 16;"],
      group: "interface",
      namespace: "interface",
      type: "uint16",
      constraints: { min: 6, max: 96 },
      default: 10,
      bind_root: {
        header: "game/debug_overlay.h",
        symbol: "debug_overlay::g_font_size",
      },
    },

    debugger_ui_scale: {
      title: "In-game debugger UI scale",
      description: "Uniformly scales the complete Dear ImGui debugger as a percentage.",
      remarks: "This scales windows, widgets, spacing, and text together. Changes take effect the next time the game starts.",
      examples: ["interface debugger_ui_scale = 125;"],
      group: "interface",
      namespace: "interface",
      type: "uint16",
      constraints: { min: 25, max: 400 },
      default: 80,
      bind_root: {
        header: "game/debug_overlay.h",
        symbol: "debug_overlay::g_ui_scale_percent",
      },
    },

    allow_lua_source_hash_mismatch: {
      title: "Allow changed Lua sources when loading saves",
      description: "Allows a saved game to load when active mod Lua files differ from the versions recorded in the save.",
      remarks: "Intended for mod development. Storage format and migration errors still prevent loading. False preserves strict source consistency checks.",
      examples: ["interface allow_lua_source_hash_mismatch = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: {
        header: "lua/lua_save.h",
        symbol: "orion2re::lua::allow_source_hash_mismatch",
      },
    },

    minimum_orbital_base_ship_class: {
      title: "Minimum ship class requiring an orbital base",
      description: "Sets the smallest combat ship class that requires a Star Base, Battlestation, or Star Fortress before construction.",
      remarks: "None allows every combat ship class without an orbital base. Cruiser preserves classic behavior.",
      examples: ["colony minimum_orbital_base_ship_class = cruiser;"],
      group: "gameplay",
      namespace: "colony",
      type: "orbital_base_requirement_ship_class",
      default: "cruiser",
      bind_root: { header: "game/colcalc.h", symbol: "COLCALC::minimum_orbital_base_ship_class" },
    },

    allow_native_annihilation: {
      title: "Allow native annihilation",
      description: "Includes native populations in colony occupation policy decisions after colonization or capture.",
      remarks: "When enabled, Democracy and Federation still assimilate natives automatically while other governments may choose annihilation. False preserves the familiar behavior where natives cannot be annihilated.",
      examples: ["gameplay allow_native_annihilation = true;"],
      group: "gameplay",
      namespace: "gameplay",
      type: "bool",
      default: false,
      bind_root: { header: "game/colony.h", symbol: "COLONY::allow_native_annihilation" },
    },

    screen_fade_speed: {
      title: "Screen fade speed",
      description: "Sets the fade increment used for ordinary screen transitions.",
      remarks: "The classic value is 10; the MOO2 1.50 default is 25. Individual screens may temporarily select their own transition speed.",
      examples: ["interface screen_fade_speed = 25;"],
      units: "percent per fade step",
      group: "interface",
      namespace: "interface",
      type: "uint8",
      constraints: { min: 1, max: 100 },
      default: 25,
      bind: ["fade_in", "fade_out"],
      bind_root: {
        header: "game/eric.h",
        symbol: "ERIC::fade_speed",
      },
    },

    animation: {
      title: "Interface animation settings",
      description: "Configures presentation-only animation pacing.",
      remarks: "Cloak steps preserve the classic normal and fast animation increments of one and two frames. Positive values through 127 preserve the authoritative uint7 domain; zero is rejected because it prevents the animation loop from advancing.",
      examples: ["interface animation cloak_steps normal = 1;", "interface animation cloak_steps fast = 2;"],
      group: "interface",
      namespace: "interface",
      type: "interface_animation",
      default: { cloak_steps: { normal: 1, fast: 2 } },
      bind_root: { header: "game/cmbtspec.h", symbol: "CMBTSPEC::animation" },
    },

    history_graph_smoothing: {
      title: "History graph smoothing",
      description: "Averages history-graph values before drawing them.",
      remarks: "True preserves classic behavior. False displays the unsmoothed graph data, matching MOO2 1.50's no_graph_smoothing setting.",
      examples: ["interface history_graph_smoothing = false;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: true,
      bind_root: {
        header: "game/info.h",
        symbol: "INFO::history_graph_smoothing",
      },
    },

    sort_serious_turn_summary_first: {
      title: "Serious turn-summary messages first",
      description: "Displays serious Turn Summary messages before other messages, preserving their order within each group.",
      remarks: "False preserves the original message order. This does not change which messages trigger a Turn Summary or hide any messages.",
      examples: ["interface sort_serious_turn_summary_first = true;"],
      group: "interface",
      namespace: "interface",
      type: "bool",
      default: false,
      bind_root: { header: "game/report.h", symbol: "REPORT::sort_serious_turn_summary_first" },
    },

    wormhole_link_color: {
      title: "Wormhole link color",
      description: "Sets the palette index used to draw links between paired wormholes on the galaxy map.",
      remarks: "The default dark gray color preserves classic behavior and MOO2 1.50.",
      examples: ["interface wormhole_link_color = 10;"],
      group: "interface",
      namespace: "interface",
      type: "uint8",
      default: 4,
      bind_root: {
        header: "game/mainscr.h",
        symbol: "MAINSCR::wormhole_link_color",
      },
    },

    ai_race_variants: {
      title: "AI race variants",
      description: "Selects the stock race-customization variants available when generating AI players.",
      remarks: "Applies only on Hard and Impossible difficulty. Values are unique variant numbers from 1 through 5; the default preserves classic selection from variants 1 through 3.",
      examples: [
        "ai ai_race_variants = 4 5;",
        "ai ai_race_variants = 1 2 3 5;",
      ],
      group: "gameplay",
      namespace: "ai",
      bind_root: { header: "game/racecust.h", symbol: "RACECUST::ai_race_variants" },
      type: {
        kind: "array", count: 6, index_base: 1,
        fill: 0, terminator: 0, implicit_terminator: true, unique: true,
        element: { type: "uint8", constraints: { min: 0, max: 5 } },
      },
      default: [1, 2, 3],
    },

    ship_scrap_refund_percent: {
      title: "Ship scrap refund percentage",
      description: "Sets the percentage of a ship's original production cost returned when it is scrapped at an owned colony.",
      remarks: "Classic returns 25 percent. Double returns 50 percent, matching the MOO2 1.50 behavior.",
      examples: ["economy ship_scrap_refund_percent = double;"],
      group: "gameplay",
      namespace: "economy",
      type: "ship_scrap_refund_percent",
      default: "classic",
      bind_root: {
        header: "game/maintain.h",
        symbol: "maintain::ship_scrap_refund_percent",
      },
    },

    stealth_field: {
      title: "Stealth Field for Stealthy AI races",
      description: "Allows Stealthy AI races to install a researched Stealth Field.",
      remarks: "False preserves classic behavior, where the Stealthy Ships trait excludes Stealth Field from AI designs.",
      examples: ["ai stealth_field = true;"],
      group: "gameplay",
      namespace: "ai",
      type: "bool",
      default: false,
      bind_root: { header: "game/aidesign.h", symbol: "aidesign::allow_stealth_field" },
    },

    autobuild_rules: {
      title: "AI autobuild rules",
      description: "Configures the weighted colony-level selector shared by AI colonies and human legacy autobuild.",
      remarks: "Native buildability remains authoritative. Colony food excludes Food Replicator output, terms use deterministic integer truncation, and square roots round down.",
      examples: [
        "ai autobuild_rules cutoff mode = relative;",
        "ai autobuild_rules candidates automated_factory weight base = 13;",
        "ai autobuild_rules candidates housing cutoff_stage = after;",
      ],
      group: "gameplay",
      namespace: "ai",
      type: "ai_autobuild_rules",
      bind_root: { header: "game/aibuild.h", symbol: "AIBUILD::autobuild_rules" },
      default_source: "native",
      include_default_configuration: false,
    },

    strategic_production: {
      title: "AI strategic production",
      description: "Configures AI-only emergency defense, economic emergency, expansion, and weighted empire allocation.",
      remarks: "Each strategic action retains its existing availability checks. Colony-level buildability checks are not applied uniformly to every strategic action.",
      examples: [
        "ai strategic_production emergency_defense order 1 = missile_base;",
        "ai strategic_production expansion colony_base_minimum_industry = 13;",
        "ai strategic_production allocation candidates defer weight defer peace = 333;",
      ],
      group: "gameplay",
      namespace: "ai",
      type: "ai_strategic_production",
      bind_root: { header: "game/aibuild.h", symbol: "AIBUILD::strategic_production" },
      default_source: "native",
      include_default_configuration: false,
    },

    race_variants: {
      title: "AI race-variant data",
      description: "Configures the native trait-assignment rows used for Hard and Impossible AI races.",
      remarks: "Rows are selected by stock race, difficulty, and variant. The separate ai_race_variants setting selects which variant numbers may be rolled.",
      examples: ["ai race_variants customization alkari hard 1 count = 2;"],
      group: "gameplay",
      namespace: "ai",
      type: "ai_race_variants",
      bind_root: { header: "game/racecust.h", symbol: "RACECUST::variants" },
      default_source: "native",
    },

    anti_missile_rocket_accuracy: {
      title: "Anti-Missile Rocket accuracy",
      description: "Configures the base chance and range penalty used by Anti-Missile Rockets.",
      remarks: "Hit chance is base minus the signed quotient of (range plus two) times multiplier divided by divisor, truncated toward zero, plus one. The divisor must be nonzero, unlike 1.50's permissive generic byte parser. Defaults preserve classic behavior and MOO2 1.50.",
      examples: ["combat anti_missile_rocket_accuracy base = 70;"],
      group: "gameplay",
      namespace: "combat",
      type: "anti_missile_rocket_accuracy",
      bind_root: { header: "game/cmbtspec.h", symbol: "CMBTSPEC::anti_missile_rocket_accuracy" },
      default: { base: 70, range_multiplier: 10, range_divisor: 3 },
    },

    ship_design: {
      title: "AI ship design priorities",
      description: "Configures ordered special-system and special-weapon choices used while the AI designs ships.",
      remarks: "Each item ID is interpreted according to its kind. The seven theme lists share allocation column 1; beam, missile, and special-weapon lists use columns 2, 3, and 5. Special-device and defense lists use columns 6 and 4. All lists preserve their native fixed lengths and default order.",
      examples: [
        "ai ship_design c1_bio_weapon 1 item = 22;",
        "ai ship_design c1_bio_weapon 1 kind = special;",
        "ai ship_design c1_missile_defense 3 kind = weapon;",
        "ai ship_design c6_special_device 1 item = 24;",
        "ai ship_design c4_defense_human_beams 1 kind = special;",
      ],
      group: "gameplay",
      namespace: "ai",
      type: "ai_ship_design",
      bind_root: { header: "game/aidesign.h", symbol: "aidesign::ship_design" },
      default_source: "native",
    },

    ship_design_allocations: {
      title: "AI ship design space allocations",
      description: "Configures Auto Design hull-space budgets by active design profile and hull size.",
      remarks: "Minus one disables an allocation step. Tactical designs use the standard_beam_missile_x2 profile after their tactical-only setup.",
      examples: ["ai ship_design_allocations standard_beam_missile_x2 frigate beams = 50;"],
      group: "gameplay",
      namespace: "ai",
      bind_root: { header: "game/aidesign.h", symbol: "aidesign::ship_design_allocations.profiles" },
      type: {
        kind: "array", count: 8, index_base: 0, index_type: "ai_ship_design_allocation_profile",
        element: { type: {
          kind: "array", count: 6, index_base: 0, index_type: "combat_ship_size_class",
          element: { type: "ai_ship_design_allocation" },
        } },
      },
      default_source: "native",
    },

    ship_design_bhg_chance: {
      title: "AI Black Hole Generator design chance",
      description: "Sets the chance that AI Titan and Doom Star designs use the special-weapon class after researching Black Hole Generator.",
      remarks: "Values 0 through 4 represent 0%, 25%, 50%, 75%, and 100%; 3 preserves classic behavior. The unrelated generic 1.50 parser also accepted 5, which had no distinct documented probability and is intentionally rejected.",
      examples: ["ai ship_design_bhg_chance = 3;"],
      group: "gameplay",
      namespace: "ai",
      type: "uint8",
      constraints: { max: 4 },
      default: 3,
      bind_root: { header: "game/aidesign.h", symbol: "aidesign::ship_design_bhg_chance" },
    },

    ship_design_stellar_chance: {
      title: "AI Stellar Converter design chance",
      description: "Sets the chance that AI Doom Star designs use the special-weapon class after researching Stellar Converter.",
      remarks: "Values 0 through 4 represent 0%, 25%, 50%, 75%, and 100%; 3 preserves classic behavior. The unrelated generic 1.50 parser also accepted 5, which had no distinct documented probability and is intentionally rejected.",
      examples: ["ai ship_design_stellar_chance = 3;"],
      group: "gameplay",
      namespace: "ai",
      type: "uint8",
      constraints: { max: 4 },
      default: 3,
      bind_root: { header: "game/aidesign.h", symbol: "aidesign::ship_design_stellar_chance" },
    },

    tech_priority: {
      title: "AI technology priorities",
      description: "Configures technology fields and applications that receive increased weight when the AI chooses its next research target.",
      remarks: "The defaults preserve MOO2 1.50: Advanced Engineering and Xeno Relations receive double weight, Neural Scanner receives double weight, and Deuterium Fuel Cells receives five times weight.",
      examples: [
        "ai tech_priority double_field_1 = advanced_engineering;",
        "ai tech_priority double_application = neural_scanner;",
        "ai tech_priority quintuple_application = deuterium_fuel_cells;",
      ],
      group: "gameplay",
      namespace: "ai",
      type: "ai_tech_priority",
      bind_root: { header: "game/newtech.h", symbol: "newtech::tech_priority" },
      default: {
        double_field_1: "advanced_engineering",
        double_field_2: "xeno_relations",
        double_application: "neural_scanner",
        quintuple_application: "deuterium_fuel_cells",
      },
    },
    alternate_diplomacy: {
      title: "Alternate diplomacy patience modifiers",
      description: "Uses the trade/research and peace modifiers when evaluating those treaty proposals.",
      remarks: "False preserves classic behavior, where every treaty proposal uses the general treaty modifier.",
      examples: ["ai alternate_diplomacy = true;"],
      group: "gameplay",
      namespace: "ai",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/diplomac.h",
        symbol: "diplomac::alternate_diplomacy",
      },
    },

    starting_relations: {
      title: "Starting diplomatic relations",
      description: "Configures initial relations from each race to every other race.",
      remarks: "Rows are directional. Defaults reproduce the complete final MOO2 1.50 matrix, including Meklar hostility toward Bulrathi.",
      examples: ["diplomacy starting_relations meklar bulrathi = -12;"],
      group: "gameplay",
      namespace: "diplomacy",
      bind_root: {
        header: "game/diplomac.h",
        symbol: "diplomac::starting_relations",
      },
      type: {
        kind: "array", count: 14, index_base: 0,
        index_type: "diplomacy_race_index",
        element: { type: {
          kind: "array", count: 14, index_base: 0,
          index_type: "diplomacy_race_index",
          element: { type: "int16" },
        } },
      },
      default_source: "native",
    },

    colony_bases_prewarp: {
      title: "Pre-Warp AI Colony Bases",
      description: "Allows AI players to build Colony Bases after researching Colony Base without a Colony Ship, fuel, or drive technology.",
      remarks: "False preserves classic AI expansion requirements.",
      examples: ["ai colony_bases_prewarp = true;"],
      group: "gameplay",
      namespace: "ai",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/aidudes.h",
        symbol: "aidudes::builds_colony_bases_prewarp",
      },
    },

    productivity_bonus: {
      title: "AI colony productivity bonus",
      description: "Adds a difficulty-dependent bonus to AI food, production, and research output.",
      remarks: "Values are twentieths of a production unit. Zero preserves no bonus for the selected difficulty.",
      examples: ["ai productivity_bonus hard = 20;"],
      group: "gameplay",
      namespace: "ai",
      bind_root: {
        header: "game/colcalc.h",
        symbol: "COLCALC::colony_job_production_difficulty_lookup",
      },
      type: {
        kind: "array", count: 5, index_base: 0, index_type: "game_difficulty",
        element: { type: "int8" },
      },
      default: [-10, 0, 10, 20, 40],
    },

    income_bonus: {
      title: "AI colony income bonus",
      description: "Adds a difficulty-dependent BC bonus per population unit to AI colony income.",
      remarks: "Values are quarters of a BC per population unit.",
      examples: ["ai income_bonus hard = 2;"],
      group: "gameplay",
      namespace: "ai",
      bind_root: {
        header: "game/colcalc.h",
        symbol: "COLCALC::difficulty_bc_lookup_table",
      },
      type: {
        kind: "array", count: 5, index_base: 0, index_type: "game_difficulty",
        element: { type: "int8" },
      },
      default: [0, 0, 1, 2, 3],
    },

    surrender_delay: {
      title: "AI surrender delay",
      description: "Sets the number of turns after game start before an AI may surrender to another AI.",
      remarks: "The delay applies only to AI-to-AI surrender evaluation. The default 150 preserves MOO2 1.50 behavior.",
      examples: ["ai surrender_delay = 150;"],
      units: "turns",
      group: "gameplay",
      namespace: "ai",
      type: "uint16",
      default: 150,
      bind_root: {
        header: "game/npcdiplo.h",
        symbol: "npcdiplo::ai_surrender_delay",
      },
    },

    eel_spawn_frequency: {
      title: "Eel offspring interval",
      description: "Sets the number of stationary turns before a wandering Space Eel attempts to produce offspring.",
      remarks: "The timer resets whenever it reaches this interval. The separate max_eels setting limits the wandering-Eel population.",
      examples: ["ai eel_spawn_frequency = 30;"],
      units: "turns",
      group: "gameplay",
      namespace: "ai",
      type: "uint8",
      constraints: { min: 1, max: 100 },
      default: 30,
      bind_root: {
        header: "game/aimove.h",
        symbol: "AIMOVE::eel_spawn_frequency",
      },
    },

    max_eels: {
      title: "Maximum wandering Eels",
      description: "Limits the number of wandering Space Eels that may be present in the galaxy.",
      examples: ["ai max_eels = 4;"],
      group: "gameplay",
      namespace: "ai",
      type: "uint8",
      constraints: { min: 1, max: 100 },
      default: 4,
      bind_root: {
        header: "game/aimove.h",
        symbol: "AIMOVE::max_eels",
      },
    },

    noreport: {
      title: "Restrict diplomacy reports",
      description: "Hides the Races screen Report action and disables Tech Exchange, Demand Tech, and Offer Tech during Audience.",
      remarks: "False preserves classic behavior. This is the restored equivalent of MOO2 1.50's /noreport ruleset option.",
      examples: ["diplomacy noreport = true;"],
      group: "gameplay",
      namespace: "diplomacy",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/dip_scrn.h",
        symbol: "DIP_SCRN::noreport",
      },
    },

    disable_scan: {
      title: "Disable tactical Scan",
      description: "Removes the Scan action from tactical combat.",
      remarks: "False preserves classic behavior. This is the restored equivalent of MOO2 1.50's /noscan ruleset option.",
      examples: ["combat disable_scan = true;"],
      group: "gameplay",
      namespace: "combat",
      type: "bool",
      default: false,
      bind_root: {
        header: "game/combat1.h",
        symbol: "COMBAT1::disable_scan",
      },
    },

    ai_hypertech_threshold: {
      title: "AI hyper-advanced technology thresholds",
      description: "Sets the number of hyper-advanced levels the AI may complete in each technology branch.",
      remarks: "The AI rerolls branches that reached their threshold and stops research after every branch reaches its configured value. All-zero defaults preserve classic behavior.",
      examples: [
        "ai ai_hypertech_threshold adv_physics = 5;",
        "ai ai_hypertech_threshold adv_power = 3;",
      ],
      group: "gameplay",
      namespace: "ai",
      bind_root: {
        header: "game/aitech.h",
        symbol: "aitech::ai_hypertech_threshold",
      },
      type: {
        kind: "array",
        count: 8,
        index_base: 204,
        index_type: "hypertech_application",
        element: { type: "uint8" },
      },
      default: [0, 0, 0, 0, 0, 0, 0, 0],
    },

    stock_race: {
      title: "Stock races",
      description: "Configures the government and racial traits of every predefined race.",
      remarks: "Rows are used by new-player initialization and the race-selection screen. Numeric pick choices use zero for no pick and one through three for the available penalty or bonus levels.",
      examples: [
        "ai stock_race human government = democracy;",
        "ai stock_race alkari growth = 0;",
        "ai stock_race silicoid growth = 1;",
        "ai stock_race sakkra growth = 3;",
      ],
      group: "gameplay",
      namespace: "ai",
      bind_root: { header: "game/racesel.h", symbol: "RACESEL::stock_race" },
      type: {
        kind: "array",
        count: 13,
        index_base: 0,
        index_type: "stock_race_index",
        element: { type: "stock_race" },
      },
      default_source: "native",
    },
    race_personality: {
      title: "AI race personalities",
      description: "Configures the personality selected for every stock race by the difficulty-adjusted random roll.",
      remarks: "At new-game initialization, the game computes Random(10) + 1 minus difficulty, clamps it to zero through nine, and selects that race's entry. The internal fourteenth row is not configurable because it is not a stock race.",
      examples: ["ai race_personality human roll roll_1 = honorable;"],
      group: "gameplay",
      namespace: "ai",
      bind_root: { header: "game/ken.h", symbol: "KEN::personalities" },
      type: {
        kind: "array", count: 13, index_base: 0, index_type: "stock_race_index",
        element: { type: { kind: "array", count: 10, index_base: 0, index_type: "random_roll_10", element: { type: "player_personality" } } },
      },
      default_source: "native",
    },
    antaran_fleet: {
      title: "Antaran fleet policy",
      description: "Configures strategic Antaran growth, attack selection, fleet composition, ship costs, and low-tier retirement.",
      remarks: "Defaults preserve classic behavior and match MOO2 1.50. The Normal retirement divisors are retained for table compatibility but the direct Normal turn limits govern those difficulties. Post-Warp uses the Average growth delay.",
      examples: [
        "ai antaran_fleet growth_delay prewarp = 200;",
        "ai antaran_fleet resource_growth frequency = 25;",
        "ai antaran_fleet resource_growth offensive_multiplier impossible = 200;",
        "ai antaran_fleet attack minimum_offensive_force_shift = 2;",
        "ai antaran_fleet ship_limit offensive harbinger = 2;",
        "ai antaran_fleet ship_cost intruder = 12;",
        "ai antaran_fleet retirement raider divisor hard = 150;",
      ],
      group: "gameplay",
      namespace: "ai",
      type: "antaran_fleet",
      bind_root: { header: "game/antarans.h", symbol: "antarans::fleet_config" },
      default_source: "native",
    },

    antaran_offensive_crew: {
      title: "Antaran offensive crew quality",
      description: "Configures the crew quality assigned to newly deployed offensive Antaran ships.",
      remarks: "Veteran preserves classic behavior. Elite assigns Elite crew and 500 experience, matching MOO2 1.50's optional elite_offensive_ants setting.",
      examples: ["ai antaran_offensive_crew = elite;"],
      group: "gameplay",
      namespace: "ai",
      type: "antaran_offensive_crew",
      default: "veteran",
