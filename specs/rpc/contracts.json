    "orbit": "One-based physical orbital position 1..5, not the compressed occupied-slot ordinal used by native planet names.",
    "half-food": "Native half-food units per farmer: 5 represents the displayed 2.5 Food, not a recalculated colony yield.",
    "percent": "Whole native gravity-productivity penalty percentage, 0, 25 or 50.",
    "bc": "Whole displayed billion credits, not a hidden economic intermediate.",
    "text": "UTF-8 rendered text, converted from the selected local game language; no raw format arguments.",
    "count": "Nonnegative integer count of authorized projected records only.",
    "bytes": "Encoded bytes, not characters. Base64 data is bounded separately from decoded resource size.",
    "native-value": "Signed displayed native slider value or score points; the owning context supplies and enforces its current range.",
    "hud-count": "Signed integer displayed by the native HUD, including negative available freighters or command points; not a hidden capacity or allocation count.",
    "food-surplus": "Signed displayed food surplus per turn.",
    "player-color": "Native empire banner palette index 0..7, not a native player slot or an RGB value.",
    "bc-per-turn": "Signed net income per turn as displayed from native surplus_bc, not gross production.",
